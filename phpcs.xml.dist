<?xml version="1.0" encoding="UTF-8"?>
<!-- Run vendor/bin/phpcs to check the custom Drupal modules. -->
<ruleset name="beantragt">
  <description>Drupal and DrupalPractice for web/modules/custom.</description>

  <file>web/modules/custom</file>

  <arg name="extensions" value="php,module,install,inc,theme,profile,yml"/>
  <arg name="basepath" value="."/>
  <arg name="report-width" value="120"/>
  <!-- Show sniff codes, so an exclusion can name the exact sniff. -->
  <arg value="s"/>

  <exclude-pattern>*/node_modules/*</exclude-pattern>
  <exclude-pattern>*/vendor/*</exclude-pattern>

  <rule ref="Drupal"/>
  <rule ref="DrupalPractice"/>
  <!--
    No exemptions. An open route (_access: 'TRUE') passes
    DrupalPractice.Yaml.RoutingAccess.OpenCallback only with a comment line
    stating the reason directly above it.
  -->
</ruleset>
