ARG DRUPAL_IMAGE
FROM ${DRUPAL_IMAGE} AS drupal

# nginx:alpine-slim drops unused modules (njs, geoip, image-filter, xslt, perl)
# and entrypoint helpers, cutting the CVE surface to ~0 High (docker scout).
# The config only needs core directives (gzip, proxy_pass, try_files).
FROM nginx:alpine-slim

COPY --from=drupal /app/data/web /app/data/web

RUN sed -i '/^user[[:space:]]\+nginx;$/d' /etc/nginx/nginx.conf \
    && sed -i 's!/run/nginx.pid!/tmp/nginx.pid!' /etc/nginx/nginx.conf \
    && rm -f /docker-entrypoint.d/10-listen-on-ipv6-by-default.sh

COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

RUN mkdir -p /var/cache/nginx /tmp/nginx \
    && chown -R nginx:nginx /var/cache/nginx /tmp/nginx

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1:8080/user/login || exit 1

USER nginx
