# The release publisher sets the version with the v prefix.
BEANTRAGT_VERSION=v0.7.3
BEANTRAGT_EXAMPLE_DATA=1

# Used by compose.build.yaml, relative to this directory.
UI_SOURCE_DIR=../../../ui
UI_PORT=13000
DRUPAL_PORT=18080
MAIL_PORT=18025

NUXT_PUBLIC_SOURCE_URL=https://github.com/civicpatches/beantragt-ui-base/tree/{version}

# For authenticated SMTP with STARTTLS, the following lines are uncommented.
# SMTP_PASSWORD_FILE points to a private file outside the source tree that contains only the password.
# BEANTRAGT_MAIL_MODE=smtp
# SMTP_HOST=smtp.example.invalid
# SMTP_PORT=587
# SMTP_USER=mailer@example.invalid
# SMTP_FROM=mailer@example.invalid
# SMTP_PASSWORD_FILE=/path/to/smtp-password

# Optional SMTP settings. EHLO defaults to the sender's domain.
# SMTP_EHLO_HOST=example.invalid
# BEANTRAGT_MAIL_REDIRECT_RECIPIENT=test@example.invalid

# The bundled Mailpit is selected by default. The mail mode above also selects the profile.
COMPOSE_PROFILES=${BEANTRAGT_MAIL_MODE:-mailpit}

# A TLS-terminating proxy is configured for production and these settings are uncommented.
# DRUPAL_TRUSTED_HOST must match the host in DRUPAL_PUBLIC_URL.
# DRUPAL_REVERSE_PROXY_ADDRESSES lists the exact trusted peers seen by Drupal.
# Details on the Nuxt BFF and reverse proxy configuration are in README.md or README.de.md.
# UI_PUBLIC_URL=https://portal.example.invalid
# DRUPAL_PUBLIC_URL=https://portal.example.invalid
# DRUPAL_TRUSTED_HOST=portal.example.invalid
# DRUPAL_REVERSE_PROXY_ADDRESSES=
