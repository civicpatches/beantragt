<?php

/**
 * @file
 * Install and update hooks for beantragt_notification.
 */

declare(strict_types=1);

use Drupal\Core\Config\StorableConfigBase;
use Drupal\user\Entity\Role;
use Drupal\language\Entity\ConfigurableLanguage;
use Drupal\Core\Extension\ModuleHandlerInterface;
use Drupal\Core\Extension\Requirement\RequirementSeverity;
use Drupal\Core\StringTranslation\TranslatableMarkup;
use Drupal\group\Entity\GroupInterface;

/**
 * Implements hook_requirements().
 */
function beantragt_notification_requirements(string $phase): array {
  if ($phase !== 'runtime') {
    return [];
  }

  $requirements = [];
  $failures = _beantragt_notification_comment_mail_hook_failures(
    \Drupal::moduleHandler(),
  );

  if ($failures === []) {
    $requirements['beantragt_notification_comment_mail_hook'] = [
      'title' => new TranslatableMarkup('beantragt.ai comment notifications'),
      'value' => new TranslatableMarkup('Hook cache registered'),
      'description' => new TranslatableMarkup(
        'The application_comment_insert hook and notification mail hook are registered. Staff and citizen comment mails can be dispatched from application_comment entity inserts.',
      ),
      'severity' => RequirementSeverity::OK,
    ];
  }
  else {
    $requirements['beantragt_notification_comment_mail_hook'] = [
      'title' => new TranslatableMarkup('beantragt.ai comment notifications'),
      'value' => new TranslatableMarkup('Hook cache missing implementation'),
      'description' => new TranslatableMarkup(
        'Comment notification hooks are not fully registered: @failures. Run drush cr or the deployment cache rebuild before accepting comment-mail smoke as valid.',
        ['@failures' => implode('; ', $failures)],
      ),
      'severity' => RequirementSeverity::Error,
    ];
  }

  $coverage = _beantragt_notification_jurisdiction_mail_template_coverage();
  if ($coverage['inspection_error'] !== NULL) {
    $requirements['beantragt_notification_jurisdiction_mail_templates'] = [
      'title' => new TranslatableMarkup('beantragt.ai jurisdiction notification templates'),
      'value' => new TranslatableMarkup('Health check unavailable'),
      'description' => new TranslatableMarkup(
        'Unable to inspect per-jurisdiction notification_mail templates: @reason. Mail can still fall back to site defaults, but deploy drift may be hidden until this check can run.',
        ['@reason' => $coverage['inspection_error']],
      ),
      'severity' => RequirementSeverity::Warning,
    ];
    return $requirements;
  }

  if ($coverage['affected'] === []) {
    $requirements['beantragt_notification_jurisdiction_mail_templates'] = [
      'title' => new TranslatableMarkup('beantragt.ai jurisdiction notification templates'),
      'value' => new TranslatableMarkup('@count jurisdiction(s) covered', ['@count' => $coverage['total']]),
      'description' => new TranslatableMarkup(
        'Every jurisdiction has a notification_mail.templates block including the locked application_confirmation_request template.',
      ),
      'severity' => RequirementSeverity::OK,
    ];
    return $requirements;
  }

  $requirements['beantragt_notification_jurisdiction_mail_templates'] = [
    'title' => new TranslatableMarkup('beantragt.ai jurisdiction notification templates'),
    'value' => new TranslatableMarkup('@count jurisdiction(s) incomplete', ['@count' => count($coverage['affected'])]),
    'description' => new TranslatableMarkup(
      'The following jurisdictions do not have a notification_mail.templates block including application_confirmation_request: @jurisdictions. Mail can still fall back to site defaults, but this masks deploy drift and should be repaired.',
      ['@jurisdictions' => _beantragt_notification_format_jurisdiction_sample($coverage['affected'])],
    ),
    'severity' => RequirementSeverity::Warning,
  ];

  return $requirements;
}

/**
 * Returns diagnostic failures for the comment notification hook chain.
 *
 * @return list<string>
 *   Human-readable failure labels for the runtime requirements report.
 */
function _beantragt_notification_comment_mail_hook_failures(ModuleHandlerInterface $module_handler): array {
  $failures = [];

  if (!$module_handler->moduleExists('beantragt_comment')) {
    $failures[] = 'beantragt_comment module is disabled';
  }
  elseif (!$module_handler->hasImplementations('application_comment_insert', 'beantragt_comment')) {
    $failures[] = 'beantragt_comment_application_comment_insert() is not registered';
  }

  if (!$module_handler->moduleExists('beantragt_notification')) {
    $failures[] = 'beantragt_notification module is disabled';
  }
  elseif (!$module_handler->hasImplementations('mail', 'beantragt_notification')) {
    $failures[] = 'beantragt_notification_mail() is not registered';
  }

  return $failures;
}

/**
 * Checks per-jurisdiction notification template coverage.
 *
 * @return array{total: int, affected: list<string>, inspection_error: string|null}
 *   Runtime coverage status.
 */
function _beantragt_notification_jurisdiction_mail_template_coverage(): array {
  try {
    if (!\Drupal::hasService('entity_type.manager')) {
      return [
        'total' => 0,
        'affected' => [],
        'inspection_error' => 'the entity_type.manager service is unavailable',
      ];
    }
    if (!\Drupal::hasService('beantragt_group.jurisdiction_config')) {
      return [
        'total' => 0,
        'affected' => [],
        'inspection_error' => 'the beantragt_group.jurisdiction_config service is unavailable',
      ];
    }

    $group_storage = \Drupal::entityTypeManager()->getStorage('group');
    $config_service = \Drupal::service('beantragt_group.jurisdiction_config');

    $groups = $group_storage->loadByProperties(['type' => 'jur']);
    $total = 0;
    $affected = [];

    foreach ($groups as $group) {
      if (!$group instanceof GroupInterface) {
        continue;
      }

      $total++;
      $section = $config_service->getSection($group, 'notification_mail');
      $templates = $section['templates'] ?? NULL;
      if (!is_array($templates) || !is_array($templates['application_confirmation_request'] ?? NULL)) {
        $affected[] = _beantragt_notification_jurisdiction_label($group);
      }
    }

    return [
      'total' => $total,
      'affected' => $affected,
      'inspection_error' => NULL,
    ];
  }
  catch (\Throwable $e) {
    return [
      'total' => 0,
      'affected' => [],
      'inspection_error' => $e->getMessage(),
    ];
  }
}

/**
 * Returns a readable jurisdiction label for status reports.
 */
function _beantragt_notification_jurisdiction_label(GroupInterface $group): string {
  $label = trim((string) $group->label());
  if ($label === '') {
    $label = 'Jurisdiction ' . $group->id();
  }

  $slug = '';
  if ($group->hasField('field_slug') && !$group->get('field_slug')->isEmpty()) {
    $slug = trim($group->get('field_slug')->getString());
  }

  return $slug === '' ? $label : sprintf('%s (%s)', $label, $slug);
}

/**
 * Formats a capped jurisdiction sample for the requirements description.
 *
 * @param list<string> $jurisdictions
 *   Affected jurisdiction labels.
 */
function _beantragt_notification_format_jurisdiction_sample(array $jurisdictions): string {
  $limit = 10;
  $sample = array_slice($jurisdictions, 0, $limit);
  $remaining = count($jurisdictions) - count($sample);
  if ($remaining > 0) {
    $sample[] = '+' . $remaining . ' more';
  }

  return implode(', ', $sample);
}

/**
