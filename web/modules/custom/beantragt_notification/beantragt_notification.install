/**
 * Implements hook_install().
 */
function beantragt_notification_install(): void {
  _beantragt_notification_ensure_platform_languages();
  _beantragt_notification_write_english_mail_templates();
}

/**
 * Ensures Drupal's Language module is installed for translated mail config.
 */
function _beantragt_notification_ensure_language_module(): bool {
  if (\Drupal::moduleHandler()->moduleExists('language')) {
    return FALSE;
  }

  /** @var \Drupal\Core\Extension\ModuleInstallerInterface $module_installer */
  $module_installer = \Drupal::service('module_installer');
  return $module_installer->install(['language'], TRUE);
}

/**
 * Ensures the platform default stays German while English is available.
 */
function _beantragt_notification_ensure_platform_languages(): bool {
  _beantragt_notification_ensure_language_module();

  if (!\Drupal::moduleHandler()->moduleExists('language')) {
    return FALSE;
  }

  if (!class_exists('\Drupal\language\Entity\ConfigurableLanguage')) {
    return FALSE;
  }

  $changed = FALSE;
  $language_manager = \Drupal::languageManager();

  foreach (['de', 'en'] as $langcode) {
    if ($language_manager->getLanguage($langcode) === NULL) {
      ConfigurableLanguage::createFromLangcode($langcode)->save();
      $changed = TRUE;
      $language_manager->reset();
    }
  }

  $site_config = \Drupal::configFactory()->getEditable('system.site');
  if ($site_config->get('default_langcode') !== 'de') {
    $site_config->set('default_langcode', 'de')->save();
    $language_manager->reset();
    $changed = TRUE;
  }

  return $changed;
}

/**
 * Writes English notification template overrides when Language is available.
 */
function _beantragt_notification_write_english_mail_templates(): array {
  if (!\Drupal::moduleHandler()->moduleExists('language')) {
    return [];
  }

  if (!\Drupal::hasService('language.config_factory_override')) {
    \Drupal::service('kernel')->rebuildContainer();
  }

  if (!\Drupal::hasService('language.config_factory_override')) {
    return [];
  }

  /** @var \Drupal\language\Config\LanguageConfigFactoryOverrideInterface $language_config_override */
  $language_config_override = \Drupal::service('language.config_factory_override');
  $override = $language_config_override->getOverride('en', 'beantragt_notification.mail');
  $updated = [];

  foreach (_beantragt_notification_english_mail_templates() as $key => $template) {
    $current = $override->get($key);
    $next = is_array($current) ? $current : [];
    $changed = FALSE;

    foreach (['subject', 'body'] as $field) {
      if (trim((string) ($next[$field] ?? '')) === '') {
        $next[$field] = $template[$field];
        $changed = TRUE;
      }
    }

    if ($changed) {
      $override->set($key, $next);
      $updated[] = $key;
    }
  }

  if ($updated !== []) {
    $override->save();
  }

  return $updated;
}

/**
 * Grants notification template management to the legacy tenant admin role.
 */
function _beantragt_notification_grant_template_permissions(): bool {
  $available_permissions = array_keys(\Drupal::service('user.permissions')->getPermissions());
  $permission = 'administer beantragt notification templates';
  if (!in_array($permission, $available_permissions, TRUE)) {
    return FALSE;
  }

  $changed = FALSE;
  $role = Role::load('department_admin');
  if ($role && !$role->hasPermission($permission)) {
    $role->grantPermission($permission);
    $role->save();
    $changed = TRUE;
  }

  return $changed;
}

/**
 * Revokes global notification template management from Department Admin.
 */
function _beantragt_notification_revoke_template_permissions_from_department_admin(): bool {
  $permission = 'administer beantragt notification templates';
  $role = Role::load('department_admin');
  if (!$role || !$role->hasPermission($permission)) {
    return FALSE;
  }

  $role->revokePermission($permission);
  $role->save();
  return TRUE;
}

/**
 * Returns the default application link line per notification template.
 *
 * @return array<string, string>
 *   Link lines keyed by notification template id.
 */
function _beantragt_notification_application_link_lines(): array {
  return [
    'application_confirmation_request' => 'Antrag bestätigen: @confirmation_url',
    'application_confirmation' => 'Antrag ansehen: @citizen_application_url',
    'status_change' => 'Antrag ansehen: @citizen_application_url',
    'approval' => 'Antrag ansehen: @citizen_application_url',
    'rejection' => 'Antrag ansehen: @citizen_application_url',
    'application_comment_staff' => 'Antrag ansehen: @citizen_application_url',
    'new_application_alert' => 'Antrag öffnen: @admin_application_url',
    'assignment_alert' => 'Antrag öffnen: @admin_application_url',
    'delegation_alert' => 'Antrag öffnen: @admin_application_url',
    'escalation_alert' => 'Antrag öffnen: @admin_application_url',
    'deadline_alert' => 'Antrag öffnen: @admin_application_url',
    'application_comment_citizen' => 'Antrag öffnen: @admin_application_url',
  ];
}

/**
 * Adds missing application link lines to one mail config object.
 *
 * @param \Drupal\Core\Config\StorableConfigBase $config
 *   Editable config or language override object.
 * @param bool $create_missing
 *   Whether missing template keys should be created.
 *
 * @return string[]
 *   Template ids updated in this config object.
 */
function _beantragt_notification_add_application_links_to_mail_config(
  StorableConfigBase $config,
  bool $create_missing = FALSE,
): array {
  $updated = [];

  foreach (_beantragt_notification_application_link_lines() as $key => $line) {
    $template = $config->get($key);
    if (!is_array($template) || empty($template['body'])) {
      if ($create_missing) {
        $defaults = \Drupal::config('beantragt_notification.mail')->get($key);
        if (is_array($defaults) && !empty($defaults['body'])) {
          $config->set($key, $defaults);
          $updated[] = $key;
        }
      }
      continue;
    }

    $body = (string) $template['body'];
    if (str_contains($body, '@citizen_application_url') || str_contains($body, '@admin_application_url')) {
      continue;
    }

    $config->set($key . '.body', rtrim($body) . "\n" . $line);
    $updated[] = $key;
  }

  if ($updated !== []) {
    $config->save();
  }

  return $updated;
}

/**
 * Checks whether a template can expose private comment contents.
 */
function _beantragt_notification_comment_template_contains_private_tokens(mixed $template): bool {
  if (!is_array($template)) {
    return FALSE;
  }

  $subject = (string) ($template['subject'] ?? '');
  $body = (string) ($template['body'] ?? '');
  $combined = strtolower($subject . "\n" . $body);

  foreach (['@comment_body', '@comment_text', '@attachments', '@attachment_links'] as $token) {
    if (str_contains($combined, $token)) {
      return TRUE;
    }
  }

  return FALSE;
}

/**
 * Adds missing safe comment notification templates.
 */
function beantragt_notification_update_10001(): string {
  $mail_config = \Drupal::configFactory()->getEditable('beantragt_notification.mail');
  $settings_config = \Drupal::configFactory()->getEditable('beantragt_notification.settings');
  $updated = [];

  foreach (_beantragt_notification_comment_mail_templates() as $key => $template) {
    $current = $mail_config->get($key);
    if (
      !is_array($current)
      || empty($current['subject'])
      || empty($current['body'])
      || _beantragt_notification_comment_template_contains_private_tokens($current)
    ) {
      $mail_config->set($key, $template);
      $settings_config->set("enabled_templates.$key", TRUE);
      $updated[] = $key;
    }
  }

  if ($updated !== []) {
    $mail_config->save();
    $settings_config->save();
  }

  return 'Added safe comment notification templates: '
    . ($updated === [] ? 'none' : implode(', ', $updated));
}

