/**
 * Returns old default phrases and their German spelling.
 *
 * @return array<string, string>
 *   Replacement map for notification subjects and bodies.
 */
function _beantragt_notification_german_mail_replacements(): array {
  return [
    'Eingangsbestaetigung' => 'Eingangsbestätigung',
    'Statusaenderung' => 'Statusänderung',
    'Rueckfrage zu Ihrem Antrag' => 'Rückfrage zu Ihrem Antrag',
    'Antwort vom Buerger zu Antrag' => 'Antwort vom Bürger zu Antrag',
    'vielen Dank fuer Ihren Antrag' => 'vielen Dank für Ihren Antrag',
    'schnellstmoeglich' => 'schnellstmöglich',
    'Bei Rueckfragen' => 'Bei Rückfragen',
    'geaendert' => 'geändert',
    'zustaendige Stelle' => 'zuständige Stelle',
    'Begruendung' => 'Begründung',
    'Antrag oeffnen:' => 'Antrag öffnen:',
    'Bitte pruefen Sie' => 'Bitte prüfen Sie',
    'Wiedervorlage faellig' => 'Wiedervorlage fällig',
    'faellig oder ueberfaellig' => 'fällig oder überfällig',
    'eine Rueckfrage' => 'eine Rückfrage',
    'die Rueckfrage im geschuetzten Bereich' => 'die Rückfrage im geschützten Bereich',
    'geschuetzten Verwaltungsbereich' => 'geschützten Verwaltungsbereich',
  ];
}

/**
 * Applies German spelling replacements to one mail config object.
 *
 * @param \Drupal\Core\Config\StorableConfigBase $config
 *   Editable config or language override object.
 *
 * @return string[]
 *   Template ids updated in this config object.
 */
function _beantragt_notification_update_german_mail_config(
  StorableConfigBase $config,
): array {
  $updated = [];
  $replacements = _beantragt_notification_german_mail_replacements();

  foreach (array_keys(\Drupal::config('beantragt_notification.mail')->getRawData()) as $key) {
    $template = $config->get($key);
    if (!is_array($template)) {
      continue;
    }

    foreach (['subject', 'body'] as $field) {
      if (!isset($template[$field]) || !is_string($template[$field])) {
        continue;
      }

      $next = strtr($template[$field], $replacements);
      if ($next === $template[$field]) {
        continue;
      }

      $config->set($key . '.' . $field, $next);
      $updated[] = $key;
    }
  }

  if ($updated !== []) {
    $config->save();
  }

  return array_values(array_unique($updated));
}

/**
 * Replaces legacy ASCII transliterations in German notification templates.
 */
