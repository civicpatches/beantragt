/**
 * Builds the per-jurisdiction notification_mail seed section.
 *
 * @return array{templates: array<string, array<string, mixed>>}
 *   Seed section keyed by template id.
 */
function _beantragt_notification_build_notification_mail_seed_section(): array {
  /** @var \Drupal\beantragt_group\Service\NotificationTemplateCatalogInterface $catalog */
  $catalog = \Drupal::service('beantragt_notification.template_catalog');
  $config_factory = \Drupal::configFactory();
  $mail_config = $config_factory->getEditable('beantragt_notification.mail');
  $settings_config = $config_factory->get('beantragt_notification.settings');
  $language_manager = \Drupal::languageManager();
  $site_default_langcode = $language_manager->getDefaultLanguage()->getId();
  $language_override = \Drupal::hasService('language.config_factory_override')
    ? \Drupal::service('language.config_factory_override')
    : NULL;

  $languages = array_keys($language_manager->getLanguages());
  if (!in_array('en', $languages, TRUE) && $language_override !== NULL) {
    $languages[] = 'en';
  }

  $section = ['templates' => []];
  foreach ($catalog->all() as $templateKey => $definition) {
    $site_default_template = NULL;
    if ($language_override !== NULL) {
      $override_template = $language_override
        ->getOverride($site_default_langcode, 'beantragt_notification.mail')
        ->get($templateKey);
      $site_default_template = is_array($override_template) ? $override_template : NULL;
    }

    $base_template = $mail_config->get($templateKey);
    $default = _beantragt_notification_template_text_from_candidates(
      $site_default_template,
      is_array($base_template) ? $base_template : NULL,
      $definition,
    );

    $enabled = $catalog->isLockedEnabled($templateKey)
      || (bool) ($settings_config->get('enabled_templates.' . $templateKey) ?? $definition['enabled']);

    $seed = [
      'enabled' => $enabled,
      'default' => $default,
    ];

    $translations = [];
    if ($language_override !== NULL) {
      foreach ($languages as $langcode) {
        if ($langcode === $site_default_langcode) {
          continue;
        }
        $translation = $language_override
          ->getOverride($langcode, 'beantragt_notification.mail')
          ->get($templateKey);
        if (is_array($translation)) {
          $translation_text = _beantragt_notification_template_text_from_candidates($translation);
          if ($translation_text !== []) {
            $translations[$langcode] = $translation_text;
          }
        }
      }
    }
    if ($translations !== []) {
      $seed['translations'] = $translations;
    }

    $section['templates'][$templateKey] = $seed;
  }

  return $section;
}

/**
 * Resolves subject/body from the first candidate that provides each field.
 *
 * @param array<string, mixed>|null ...$candidates
 *   Candidate template entries.
 *
 * @return array<string, string>
 *   Template text.
 */
function _beantragt_notification_template_text_from_candidates(?array ...$candidates): array {
  $text = [];

  foreach (['subject', 'body'] as $field) {
    foreach ($candidates as $candidate) {
      if (is_array($candidate) && array_key_exists($field, $candidate) && is_string($candidate[$field]) && trim($candidate[$field]) !== '') {
        $text[$field] = $candidate[$field];
        break;
      }
    }
  }

  return $text;
}

/**
 * Fills missing notification_mail template keys on one existing section.
 *
 * @param array<string, mixed> $section
 *   Existing notification_mail section.
 * @param array{templates: array<string, array<string, mixed>>} $seed
 *   Seed notification_mail section.
 *
 * @return array{templates: array<string, array<string, mixed>>}
 *   Merged section.
 */
function _beantragt_notification_merge_notification_mail_seed(array $section, array $seed): array {
  $current_templates = is_array($section['templates'] ?? NULL) ? $section['templates'] : [];
  $next = ['templates' => $current_templates];

  foreach ($seed['templates'] as $templateKey => $seed_template) {
    $current = is_array($next['templates'][$templateKey] ?? NULL) ? $next['templates'][$templateKey] : [];
    if ($current === []) {
      $next['templates'][$templateKey] = $seed_template;
      continue;
    }

    if (!array_key_exists('enabled', $current)) {
      $current['enabled'] = $seed_template['enabled'];
    }
    if ($templateKey === 'application_confirmation_request') {
      $current['enabled'] = TRUE;
    }

    $current_default = is_array($current['default'] ?? NULL) ? $current['default'] : [];
    $seed_default = is_array($seed_template['default'] ?? NULL) ? $seed_template['default'] : [];
    foreach (['subject', 'body'] as $field) {
      if (!array_key_exists($field, $current_default) && array_key_exists($field, $seed_default)) {
        $current_default[$field] = $seed_default[$field];
      }
    }
    if ($current_default !== []) {
      $current['default'] = $current_default;
    }

    $seed_translations = is_array($seed_template['translations'] ?? NULL) ? $seed_template['translations'] : [];
    if ($seed_translations !== []) {
      $translations = is_array($current['translations'] ?? NULL) ? $current['translations'] : [];
      foreach ($seed_translations as $langcode => $translation) {
        if (!is_array($translation) || $translation === []) {
          continue;
        }
        if (!array_key_exists($langcode, $translations)) {
          $translations[$langcode] = $translation;
          continue;
        }
        if (!is_array($translations[$langcode])) {
          $translations[$langcode] = $translation;
          continue;
        }
        foreach (['subject', 'body'] as $field) {
          if (!array_key_exists($field, $translations[$langcode]) && array_key_exists($field, $translation)) {
            $translations[$langcode][$field] = $translation[$field];
          }
        }
      }
      $current['translations'] = $translations;
    }

    $next['templates'][$templateKey] = $current;
  }

  return $next;
}

/**
 * Seeds notification_mail templates into all jurisdiction config blobs.
 */
function beantragt_notification_update_10015(): string {
  /** @var \Drupal\Core\Entity\EntityStorageInterface $group_storage */
  $group_storage = \Drupal::entityTypeManager()->getStorage('group');
  /** @var \Drupal\beantragt_group\Service\JurisdictionConfigServiceInterface $config_service */
  $config_service = \Drupal::service('beantragt_group.jurisdiction_config');
  $seed = _beantragt_notification_build_notification_mail_seed_section();
  $updated = 0;
  $groups = $group_storage->loadByProperties(['type' => 'jur']);

  foreach ($groups as $group) {
    if (!$group instanceof GroupInterface) {
      continue;
    }
    $current = $config_service->getSection($group, 'notification_mail');
    $next = _beantragt_notification_merge_notification_mail_seed($current, $seed);
    if ($next !== $current) {
      $config_service->updateSection($group, 'notification_mail', $next);
      $updated++;
    }
  }

  return 'Seeded jurisdiction notification_mail templates for jurisdictions: ' . $updated;
}

/**
 * Adds delegation notification templates and enables the default.
 */
function beantragt_notification_update_10016(): string {
  $mail_config = \Drupal::configFactory()->getEditable('beantragt_notification.mail');
  $settings_config = \Drupal::configFactory()->getEditable('beantragt_notification.settings');
  $updated = [];

  foreach (_beantragt_notification_delegation_mail_templates() as $key => $template) {
    $current = $mail_config->get($key);
    if (!is_array($current) || empty($current['subject']) || empty($current['body'])) {
      $mail_config->set($key, $template);
      $updated[] = $key;
    }
    $settings_config->set("enabled_templates.$key", TRUE);
  }

  if ($updated !== []) {
    $mail_config->save();
  }
  $settings_config->save();

  $english_updated = _beantragt_notification_write_english_mail_templates();
  $jurisdictions_seeded = 0;

  if (\Drupal::hasService('beantragt_group.jurisdiction_config')) {
    /** @var \Drupal\Core\Entity\EntityStorageInterface $group_storage */
    $group_storage = \Drupal::entityTypeManager()->getStorage('group');
    /** @var \Drupal\beantragt_group\Service\JurisdictionConfigServiceInterface $config_service */
    $config_service = \Drupal::service('beantragt_group.jurisdiction_config');
    $seed = _beantragt_notification_build_notification_mail_seed_section();

    foreach ($group_storage->loadByProperties(['type' => 'jur']) as $group) {
      if (!$group instanceof GroupInterface) {
        continue;
      }
      $current = $config_service->getSection($group, 'notification_mail');
      $next = _beantragt_notification_merge_notification_mail_seed($current, $seed);
      if ($next !== $current) {
        $config_service->updateSection($group, 'notification_mail', $next);
        $jurisdictions_seeded++;
      }
    }
  }

  return 'Added delegation notification templates: '
    . ($updated === [] ? 'none' : implode(', ', $updated))
    . '; added English notification templates: '
    . ($english_updated === [] ? 'none' : implode(', ', $english_updated))
    . '; seeded jurisdiction notification_mail templates for jurisdictions: '
    . $jurisdictions_seeded;
}

