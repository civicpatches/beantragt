      $updated[] = $key;
    }
    $settings_config->set("enabled_templates.$key", TRUE);
  }

  if ($updated !== []) {
    $mail_config->save();
  }
  $settings_config->save();

  $english_updated = _beantragt_notification_write_english_mail_templates();
  $jurisdictions_seeded = 0;

  if (\Drupal::hasService('beantragt_group.jurisdiction_config')) {
    /** @var \Drupal\Core\Entity\EntityStorageInterface $group_storage */
    $group_storage = \Drupal::entityTypeManager()->getStorage('group');
    /** @var \Drupal\beantragt_group\Service\JurisdictionConfigServiceInterface $config_service */
    $config_service = \Drupal::service('beantragt_group.jurisdiction_config');
    $seed = _beantragt_notification_build_notification_mail_seed_section();

    foreach ($group_storage->loadByProperties(['type' => 'jur']) as $group) {
      if (!$group instanceof GroupInterface) {
        continue;
      }
      $current = $config_service->getSection($group, 'notification_mail');
      $next = _beantragt_notification_merge_notification_mail_seed($current, $seed);
      if ($next !== $current) {
        $config_service->updateSection($group, 'notification_mail', $next);
        $jurisdictions_seeded++;
      }
    }
  }

  return 'Added resubmission reminder notification templates: '
    . ($updated === [] ? 'none' : implode(', ', $updated))
    . '; added English notification templates: '
    . ($english_updated === [] ? 'none' : implode(', ', $english_updated))
    . '; seeded jurisdiction notification_mail templates for jurisdictions: '
    . $jurisdictions_seeded;
}

/**
 * Adds external response notifications without changing existing templates.
 */
function beantragt_notification_update_10018(): string {
  $factory = \Drupal::configFactory();
  $mail = $factory->getEditable('beantragt_notification.mail');
  if ($mail->get('external_response_available') === NULL) {
    $mail->set('external_response_available', [
      'subject' => 'Ein neues Dokument zu Ihrem Antrag @reference_number',
      'body' => "Zu Ihrem Antrag liegt ein neues Dokument im Bürgerportal bereit.\n\nBitte melden Sie sich an, um es abzurufen:\n@citizen_application_url",
    ])->save();
  }
  $settings = $factory->getEditable('beantragt_notification.settings');
  if ($settings->get('enabled_templates.external_response_available') === NULL) {
    $settings->set('enabled_templates.external_response_available', TRUE)->save();
  }
  _beantragt_notification_write_english_mail_templates();
  return 'Added citizen notifications for released external responses.';
}

/**
 * Implements hook_schema().
 */
function beantragt_notification_schema(): array {
  return [
    'beantragt_reminder_schedule' => [
      'description' => 'Indexed internal due dates for bounded staff reminders.',
      'fields' => [
        'application_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
        'status_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
        'status_entered' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
        'escalation_due' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
        'reminder_due' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
      ],
      'primary key' => ['application_id'],
      'indexes' => [
        'escalation_due' => ['escalation_due', 'application_id'],
        'reminder_due' => ['reminder_due', 'application_id'],
      ],
    ],
  ];
}

/**
 * Adds indexed reminder due dates; cron backfills existing cases in pages.
 */
function beantragt_notification_update_10019(): string {
  $database = \Drupal::database();
  if (!$database->schema()->tableExists('beantragt_reminder_schedule')) {
    $database->schema()->createTable('beantragt_reminder_schedule', beantragt_notification_schema()['beantragt_reminder_schedule']);
  }
  \Drupal::state()->set('beantragt_notification.schedule_rebuild', TRUE);
  \Drupal::state()->set('beantragt_notification.schedule_cursor', 0);
  return 'Added reminder schedule. Cron backfills at most 100 applications per run.';
}

/**
 * Clears old cached per-case markers read directly from key/value storage.
 */
function beantragt_notification_update_10020(): string {
  \Drupal::state()->resetCache();
  return 'Cleared cached reminder markers. Legacy values remain in direct key/value storage.';
}

/**
 * Updates standard office wording in stored German notification templates.
 */
function beantragt_notification_update_10021(): void {
  $replacements = [
    'status_change' => [
      'Bei Fragen wenden Sie sich bitte an Ihre zuständige Stelle.' => 'Bei Fragen wenden Sie sich bitte an Ihre zuständige Dienststelle.',
      'Bei Fragen wenden Sie sich bitte an Ihre zustaendige Stelle.' => 'Bei Fragen wenden Sie sich bitte an Ihre zuständige Dienststelle.',
    ],
    'rejection' => [
      'Ihre zuständige Stelle.' => 'Ihre zuständige Dienststelle.',
      'Ihre zustaendige Stelle.' => 'Ihre zuständige Dienststelle.',
    ],
    'delegation_alert' => [
      'Ein Antrag wurde an Ihre Organisation delegiert.' => 'Ein Antrag wurde an Ihre Dienststelle delegiert.',
    ],
  ];

  $factory = \Drupal::configFactory();
  $configs = [$factory->getEditable('beantragt_notification.mail')];
  if (\Drupal::hasService('language.config_factory_override')) {
    /** @var \Drupal\language\Config\LanguageConfigFactoryOverrideInterface $override */
    $override = \Drupal::service('language.config_factory_override');
    $configs[] = $override->getOverride('de', 'beantragt_notification.mail');
  }

  foreach ($configs as $config) {
    $changed = FALSE;
    foreach ($replacements as $key => $phrases) {
      $path = $key . '.body';
      $body = $config->get($path);
      if (is_string($body) && ($next = strtr($body, $phrases)) !== $body) {
        $config->set($path, $next);
        $changed = TRUE;
      }
    }
    if ($changed) {
      $config->save();
    }
  }

  /** @var \Drupal\beantragt_group\Service\JurisdictionConfigServiceInterface $service */
  $service = \Drupal::service('beantragt_group.jurisdiction_config');
  $storage = \Drupal::entityTypeManager()->getStorage('group');
  foreach ($storage->loadByProperties(['type' => 'jur']) as $group) {
    if (!$group instanceof GroupInterface) {
      continue;
    }
    $service->withLockedGroup($group, static function (GroupInterface $fresh) use ($service, $replacements): void {
      $section = $service->getSection($fresh, 'notification_mail');
      $next = $section;
      foreach ($replacements as $key => $phrases) {
        $body = $section['templates'][$key]['default']['body'] ?? NULL;
        if (is_string($body)) {
          $next['templates'][$key]['default']['body'] = strtr($body, $phrases);
        }
        $body = $section['templates'][$key]['translations']['de']['body'] ?? NULL;
        if (is_string($body)) {
          $next['templates'][$key]['translations']['de']['body'] = strtr($body, $phrases);
        }
      }
      if ($next !== $section) {
        $service->updateSection($fresh, 'notification_mail', $next);
      }
    });
  }
}
