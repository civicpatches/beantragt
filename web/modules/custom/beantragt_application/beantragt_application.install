/**
 * Implements hook_requirements().
 */
function beantragt_application_requirements(string $phase): array {
  if ($phase !== 'runtime') {
    return [];
  }
  $pending = \Drupal::state()->get(ApplicationDataProtectionService::BACKFILL_PENDING_STATE_KEY, []);
  if ($pending === []) {
    return [];
  }
  return [
    'beantragt_application_data_backfill' => [
      'title' => t('Application data protection update'),
      'value' => t('@count applications awaiting encryption', ['@count' => count($pending)]),
      'description' => t('Restore the submitted form definitions, then run drush beantragt:retry-data-protection. See the beantragt_application.data_backfill_pending state entry for the application IDs.'),
      'severity' => REQUIREMENT_WARNING,
    ],
  ];
}

/**
 * Implements hook_schema().
 *
 * Defines the beantragt_ref_sequence table for atomic sequence counters.
 * Each row tracks the current sequence number for a given org + scope + year
 * combination, enabling race-condition-safe reference number generation.
 *
 * The scope_id dimension lets forms with a per-form reference pattern keep
 * their own independent sequence (scope_id = form_schema id). Forms without a
 * per-form pattern share the organisation sequence (scope_id = 0).
 */
function beantragt_application_schema(): array {
  $schema[ProtectedAccessLog::TABLE] = ProtectedAccessLog::schema();
  $schema[ApplicationMessageReadState::TABLE] = ApplicationMessageReadState::schema();
  $schema[ApplicationEventReadState::RECEIPTS_TABLE] = ApplicationEventReadState::receiptSchema();
  $schema['beantragt_ref_sequence'] = [
    'description' => 'Stores per-org per-scope per-year sequence counters for reference numbers.',
    'fields' => [
      'org_id' => [
        'description' => 'The group ID of the organisation (0 for global/unaffiliated).',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
      'scope_id' => [
        'description' => 'The sequence scope: form_schema id for per-form patterns, 0 for the shared org sequence.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
      'year' => [
        'description' => 'The four-digit year.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'sequence' => [
        'description' => 'The current sequence number.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
    ],
    'primary key' => ['org_id', 'scope_id', 'year'],
  ];

  return $schema;
}

/**
 * Adds the scope_id dimension to the reference sequence table.
 *
 * Enables per-form sequence counters: forms with their own reference pattern
 * number from 1 independently (scope_id = form_schema id) while forms sharing
 * the organisation pattern keep their existing shared sequence (scope_id = 0).
 *
 * Backfills every existing row to scope_id = 0 (the org-shared sequence) so the
 * pre-existing org/year numbering continues unchanged, then rebuilds the
 * primary key as (org_id, scope_id, year).
 */
function beantragt_application_update_10001(): string {
  $schema = \Drupal::database()->schema();

  if (!$schema->tableExists('beantragt_ref_sequence')) {
    // Fresh installs already get the new shape from hook_schema().
    return 'Reference sequence table not present; nothing to migrate.';
  }

  if ($schema->fieldExists('beantragt_ref_sequence', 'scope_id')) {
    return 'scope_id column already present; nothing to do.';
  }

  // Drop the existing primary key before adding the column, then re-add it
  // with the new composite definition. Existing rows backfill to scope_id = 0
  // via the column default, preserving the current org/year sequences.
  $schema->dropPrimaryKey('beantragt_ref_sequence');
  $schema->addField(
    'beantragt_ref_sequence',
    'scope_id',
    [
      'description' => 'The sequence scope: form_schema id for per-form patterns, 0 for the shared org sequence.',
      'type' => 'int',
      'unsigned' => TRUE,
      'not null' => TRUE,
      'default' => 0,
    ],
    ['primary key' => ['org_id', 'scope_id', 'year']],
  );

  return 'Added scope_id dimension to beantragt_ref_sequence; existing rows backfilled to scope_id = 0.';
}

/**
 * Revokes global workflow-status administration from the service account.
 */
function beantragt_application_update_10002(): string {
  return _beantragt_application_revoke_service_account_permissions([
    'administer workflow_status entities',
  ]);
}

/**
 * Installs workflow attributes storage for existing application entities.
 */
function beantragt_application_update_10003(): string {
  $update_manager = \Drupal::entityDefinitionUpdateManager();
  if ($update_manager->getFieldStorageDefinition('field_workflow_attributes', 'application')) {
    return 'Application workflow attributes field already installed.';
  }

  $entity_type = \Drupal::entityTypeManager()->getDefinition('application');
  $field_definitions = Application::baseFieldDefinitions($entity_type);
  $field_definition = $field_definitions['field_workflow_attributes'];
  if (!$field_definition instanceof BaseFieldDefinition) {
    throw new \RuntimeException('Application workflow attributes field definition is invalid.');
  }
  $field_definition->setName('field_workflow_attributes');
  $field_definition->setTargetEntityTypeId('application');

  $update_manager->installFieldStorageDefinition(
    'field_workflow_attributes',
    'application',
    'beantragt_application',
    $field_definition,
  );

  return 'Installed workflow attributes field on application entities.';
}

