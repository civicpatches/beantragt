/**
 * Installs application attachment entity storage for public file fields.
 */
function beantragt_application_update_10005(): string {
  $update_manager = \Drupal::entityDefinitionUpdateManager();
  if ($update_manager->getEntityType('application_attachment')) {
    return 'Application attachment entity storage already installed.';
  }

  $entity_type = \Drupal::entityTypeManager()->getDefinition('application_attachment');
  $update_manager->installEntityType($entity_type);

  return 'Installed application_attachment entity storage.';
}

/**
 * Grants service-account attachment permissions.
 */
function beantragt_application_update_10006(): string {
  $role = \Drupal::entityTypeManager()->getStorage('user_role')->load('service_account');
  if (!$role) {
    return 'service_account role not found.';
  }

  $changed = FALSE;
  foreach ([
    'create application_attachment entities',
    'view application_attachment entities',
  ] as $permission) {
    if (!$role->hasPermission($permission)) {
      $role->grantPermission($permission);
      $changed = TRUE;
    }
  }

  if (!$changed) {
    return 'service_account attachment permissions already present.';
  }

  $role->save();
  return 'Granted service_account attachment permissions.';
}

/**
 * Removes anonymous direct access to private application collections.
 */
function beantragt_application_update_10007(): string {
  $role = \Drupal::entityTypeManager()->getStorage('user_role')->load('anonymous');
  if (!$role) {
    return 'anonymous role not found.';
  }

  $changed = FALSE;
  foreach ([
    'view published application entities',
    'view unpublished application entities',
    'view application_attachment entities',
  ] as $permission) {
    if ($role->hasPermission($permission)) {
      $role->revokePermission($permission);
      $changed = TRUE;
    }
  }

  if (!$changed) {
    return 'Anonymous application collection permissions already absent.';
  }

  $role->save();
  return 'Revoked anonymous application collection permissions.';
}

/**
 * Installs malware scan fields on application attachments.
 */
function beantragt_application_update_10008(): string {
  $update_manager = \Drupal::entityDefinitionUpdateManager();
  $entity_type = \Drupal::entityTypeManager()->getDefinition('application_attachment');
  $field_definitions = ApplicationAttachment::baseFieldDefinitions($entity_type);
  $installed = [];

  foreach (['field_scan_status', 'field_scan_message'] as $field_name) {
    if ($update_manager->getFieldStorageDefinition($field_name, 'application_attachment')) {
      continue;
    }
    $field_definition = $field_definitions[$field_name] ?? NULL;
    if (!$field_definition instanceof BaseFieldDefinition) {
      throw new \RuntimeException(sprintf('Application attachment field %s definition is invalid.', $field_name));
    }
    $field_definition->setName($field_name);
    $field_definition->setTargetEntityTypeId('application_attachment');
    $update_manager->installFieldStorageDefinition(
      $field_name,
      'application_attachment',
      'beantragt_application',
      $field_definition,
    );
    $installed[] = $field_name;
  }

  return $installed === []
    ? 'Application attachment scan fields already installed.'
    : 'Installed application attachment scan fields: ' . implode(', ', $installed) . '.';
}

/**
 * Grants quarantine management to department administrators.
 */
function beantragt_application_update_10009(): string {
  $role = \Drupal::entityTypeManager()->getStorage('user_role')->load('department_admin');
  if (!$role) {
    return 'department_admin role not found.';
  }

  $permission = 'manage quarantined application attachments';
  if ($role->hasPermission($permission)) {
    return 'department_admin quarantine permission already present.';
  }

  $role->grantPermission($permission);
  $role->save();
  return 'Granted quarantine attachment permission to department_admin.';
}

/**
 * Implements hook_install().
 */
function beantragt_application_install(): void {
  _beantragt_application_initialize_message_baseline();
  $messages = [];
  $messages = array_merge($messages, _beantragt_application_ensure_service_account());
  $messages = array_merge($messages, _beantragt_application_ensure_default_settings());
  $messages = array_merge($messages, _beantragt_application_grant_delegate_permissions());

  if (!empty($messages)) {
    \Drupal::logger('beantragt_application')->notice(implode(' ', $messages));
  }
}

/**
 * Ensures the service account role and user exist with correct permissions.
 *
 * @return string[]
 *   Status messages.
 */
function _beantragt_application_ensure_service_account(): array {
  $messages = [];
  $role_storage = \Drupal::entityTypeManager()->getStorage('user_role');
  $role = $role_storage->load('service_account');
  if (!$role) {
    $role = $role_storage->create([
      'id' => 'service_account',
      'label' => 'Service Account',
      'weight' => 5,
    ]);
    $role->save();
    $messages[] = 'Created service_account role.';
  }

  $service_permissions = [
    'create form_schema entities',
    'edit any form_schema entities',
    'create application entities',
    'create application_attachment entities',
    'edit any application entities',
    'view published form_schema entities',
    'view unpublished form_schema entities',
    'view own application entities',
    'view published application entities',
    'view application_attachment entities',
    'create applicant entities',
    'edit own applicant entities',
    'create application_comment entities',
    'view application_comment entities',
    // Guided form setup: verified information sheet recommendations.
    // The service account never gets "publish form_schema entities".
    'record form setup recommendations',
  ];
  foreach ($service_permissions as $permission) {
    $role->grantPermission($permission);
  }
  $role->save();
  $messages[] = 'Granted permissions to service_account role.';

  $user_storage = \Drupal::entityTypeManager()->getStorage('user');
  $existing = $user_storage->loadByProperties(['name' => 'nuxt_service']);
  if (empty($existing)) {
    /** @var \Drupal\user\UserInterface $user */
    $user = $user_storage->create([
      'name' => 'nuxt_service',
      'mail' => 'nuxt-service@beantragt.local',
      'status' => 1,
      'roles' => ['service_account'],
    ]);
    $user->setPassword(_beantragt_application_service_account_password());
    $user->save();
    $messages[] = 'Created nuxt_service user (uid=' . $user->id() . ').';
  }
  else {
    $user = reset($existing);
    if (!$user->hasRole('service_account')) {
      $user->addRole('service_account');
      $user->save();
    }
    $messages[] = 'nuxt_service user already exists (uid=' . $user->id() . ').';
  }

  /** @var \Drupal\user\RoleInterface|null $anonymous */
  $anonymous = $role_storage->load('anonymous');
  if ($anonymous) {
    $anonymous->revokePermission('create form_schema entities');
    $anonymous->revokePermission('create application entities');
    $anonymous->revokePermission('view published application entities');
    $anonymous->revokePermission('view unpublished application entities');
    $anonymous->revokePermission('view application_attachment entities');
    $anonymous->revokePermission('create applicant entities');
    $anonymous->revokePermission('edit own applicant entities');
    $anonymous->save();
    $messages[] = 'Revoked create permissions from anonymous role.';
  }

  /** @var \Drupal\user\RoleInterface|null $authenticated */
  $authenticated = $role_storage->load('authenticated');
  if ($authenticated) {
    $authenticated->revokePermission('create form_schema entities');
    $authenticated->revokePermission('create application entities');
    $authenticated->revokePermission('create applicant entities');
    $authenticated->revokePermission('edit own applicant entities');
    $authenticated->save();
    $messages[] = 'Revoked direct mutation permissions from authenticated role.';
  }

  return $messages;
}

/**
 * Revokes permissions from the service account role.
 *
 * @param string[] $permissions
 *   Permissions to revoke.
 *
 * @return string
 *   Update status message.
 */
function _beantragt_application_revoke_service_account_permissions(array $permissions): string {
  $role = \Drupal::entityTypeManager()->getStorage('user_role')->load('service_account');
  if (!$role) {
    return 'service_account role not found.';
  }

  $revoked = [];
  foreach ($permissions as $permission) {
    if ($role->hasPermission($permission)) {
      $role->revokePermission($permission);
      $revoked[] = $permission;
    }
  }

  if (!$revoked) {
    return 'service_account permissions already hardened.';
  }

  $role->save();
  return 'Revoked service_account permissions: ' . implode(', ', $revoked) . '.';
}

/**
 * Returns the configured service account password or a generated local value.
 *
 * @return string
 *   The password to set during fresh local installs.
 */
function _beantragt_application_service_account_password(): string {
  $password = getenv('NUXT_DRUPAL_SERVICE_PASSWORD');
  if (is_string($password) && $password !== '') {
    return $password;
  }

  return \Drupal::service('password_generator')->generate(32);
}

/**
 * Ensures default module settings and GDPR permissions exist.
 *
 * @return string[]
 *   Status messages.
 */
function _beantragt_application_ensure_default_settings(): array {
  $messages = [];
  $config = \Drupal::configFactory()->getEditable('beantragt_application.settings');
  if ($config->isNew()) {
    $config
      ->set('data_retention_days', 730)
      ->set('attachment_max_total_bytes_per_application', 52428800)
      ->set('confirmation_token_ttl_hours', 72)
      ->set('confirmation_purge_hours', 168)
      ->save();
    $messages[] = 'Created beantragt_application.settings with retention and attachment quota defaults.';
  }
  else {
    $changed = FALSE;
    if ($config->get('attachment_max_total_bytes_per_application') === NULL) {
      $config->set('attachment_max_total_bytes_per_application', 52428800);
      $changed = TRUE;
    }
    if ($config->get('confirmation_token_ttl_hours') === NULL) {
      $config->set('confirmation_token_ttl_hours', 72);
      $changed = TRUE;
    }
    if ($config->get('confirmation_purge_hours') === NULL) {
      $config->set('confirmation_purge_hours', 168);
      $changed = TRUE;
    }
    if ($changed) {
      $config->save();
      $messages[] = 'Updated beantragt_application.settings attachment quota defaults.';
    }
    $messages[] = 'beantragt_application.settings already exists.';
  }

  $role_storage = \Drupal::entityTypeManager()->getStorage('user_role');
  /** @var \Drupal\user\RoleInterface|null $authenticated */
  $authenticated = $role_storage->load('authenticated');
  if ($authenticated) {
    // Citizens never delete submitted applications themselves (they stay
    // with the authority); update 10024 revokes the earlier grant.
    $gdpr_permissions = [
      'delete own applicant entities',
      'view own applicant entities',
      'view own application entities',
    ];
    foreach ($gdpr_permissions as $permission) {
      $authenticated->grantPermission($permission);
    }
    $authenticated->save();
    $messages[] = 'Granted GDPR self-service permissions to authenticated role.';
  }

  return $messages;
}

/**
 * Adds default aggregate attachment quota settings.
 */
function beantragt_application_update_10010(): string {
  $config = \Drupal::configFactory()->getEditable('beantragt_application.settings');
  if ($config->get('attachment_max_total_bytes_per_application') === NULL) {
    $config->set('attachment_max_total_bytes_per_application', 52428800)->save();
    return 'Set default aggregate attachment quota to 50 MB per application.';
  }
  return 'Aggregate attachment quota setting already exists.';
}

