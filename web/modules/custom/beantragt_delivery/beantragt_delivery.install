      'size' => 'normal',
      'not null' => FALSE,
    ]);
  }
  return 'Added connection presentation; existing connections keep closing on the decision notice.';
}

/**
 * Marks external responses whose documents carry protected data.
 */
function beantragt_delivery_update_10011(): string {
  $schema = \Drupal::database()->schema();
  if ($schema->tableExists('beantragt_external_response') && !$schema->fieldExists('beantragt_external_response', 'contains_protected')) {
    $schema->addField('beantragt_external_response', 'contains_protected', [
      'type' => 'int',
      'size' => 'tiny',
      'unsigned' => TRUE,
      'not null' => TRUE,
      'default' => 0,
    ]);
  }
  return 'Added the protected-data flag to external responses; existing responses stay unflagged.';
}

/**
 * Flags provided docgen notices that carry protected data in clear text.
 */
function beantragt_delivery_update_10012(): string {
  $database = \Drupal::database();
  $schema = $database->schema();
  if (!$schema->tableExists('beantragt_docgen_document') || !$schema->fieldExists('beantragt_external_response', 'contains_protected')) {
    return 'No decision documents to check.';
  }
  $responses = [];
  $rows = $database->select('beantragt_docgen_document', 'd')
    ->fields('d', ['response_uuid', 'missing'])
    ->isNotNull('d.response_uuid')
    ->execute();
  foreach ($rows as $row) {
    $flags = json_decode((string) ($row->missing ?? ''), TRUE);
    if (is_array($flags) && ($flags['protectedValues'] ?? FALSE) === TRUE) {
      $responses[(string) $row->response_uuid] = TRUE;
    }
  }
  if ($responses !== []) {
    $database->update('beantragt_external_response')
      ->fields(['contains_protected' => 1])
      ->condition('uuid', array_keys($responses), 'IN')
      ->execute();
  }
  return 'Flagged ' . count($responses) . ' provided decision notice(s) with protected data.';
}

/**
 * Adds transfer triggers to assignments and trigger metadata to intents.
 *
 * Existing rules keep planning on submission, exactly as before.
 */
function beantragt_delivery_update_10013(): string {
  $schema = \Drupal::database()->schema();
  $frozen = _beantragt_delivery_update_schema(10013);
  $tables = [
    'beantragt_integration_assignment' => 'assignment_fields',
    'beantragt_transfer_plan' => 'transfer_plan_fields',
  ];
  foreach ($tables as $table => $key) {
    if (!$schema->tableExists($table)) {
      continue;
    }
    foreach ($frozen[$key] as $name => $definition) {
      if (!$schema->fieldExists($table, $name)) {
        $schema->addField($table, $name, $definition);
      }
    }
  }
  return 'Added transfer triggers (default: on submission) and trigger metadata of planning intents.';
}

