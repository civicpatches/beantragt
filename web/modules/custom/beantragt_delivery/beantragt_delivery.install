/**
 * Protects existing FIT-Connect responses, including already released copies.
 */
function beantragt_delivery_update_10017(): string {
  $database = \Drupal::database();
  if (!$database->schema()->tableExists('beantragt_external_response')) {
    return 'Protected 0 existing FIT-Connect responses (table absent).';
  }
  $count = $database->update('beantragt_external_response')
    ->fields(['contains_protected' => 1])
    ->condition('source', 'fit_connect')
    ->condition('contains_protected', 0)
    ->execute();
  return sprintf('Protected %d existing FIT-Connect responses.', $count);
}
