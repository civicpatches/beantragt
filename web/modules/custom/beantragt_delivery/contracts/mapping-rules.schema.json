{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "rules"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "rules": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "target"
        ],
        "properties": {
          "source": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,99}$"
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "^(/([^~/]|~[01])*)+$"
          },
          "valueMap": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 500,
            "propertyNames": {
              "maxLength": 255
            },
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean"
              ],
              "maxLength": 255
            }
          }
        }
      }
    },
    "occurrences": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target",
          "mode"
        ],
        "properties": {
          "target": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "^(/([^~/]|~[01])*)+$"
          },
          "mode": {
            "const": "single"
          }
        }
      }
    }
  }
}
