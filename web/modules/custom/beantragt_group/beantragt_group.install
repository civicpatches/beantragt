<?php

/**
 * @file
 * Install, update and uninstall functions for beantragt_group module.
 */

declare(strict_types=1);

use Drupal\Core\Config\FileStorage;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Utility\UpdateException;
use Drupal\group\Entity\GroupInterface;
use Drupal\language\ConfigurableLanguageManagerInterface;

/**
 * Implements hook_install().
 */
function beantragt_group_install(): void {
  $entity_type_manager = \Drupal::entityTypeManager();

  _beantragt_group_ensure_settings();

  // Ensure field_slug exists on both group types (also created via update_10003
  // for existing installations, but needed here for fresh installs).
  _beantragt_group_ensure_slug_field($entity_type_manager);
  _beantragt_group_ensure_org_directory_fields($entity_type_manager);
  _beantragt_group_ensure_org_parent_field($entity_type_manager);
  _beantragt_group_ensure_jurisdiction_contact_email_field($entity_type_manager);
  _beantragt_group_ensure_admin_form_displays();
  _beantragt_group_ensure_admin_theme();

  _beantragt_group_install_scope_field_storages();
  _beantragt_group_ensure_workspace_inviter_scope();
  _beantragt_group_ensure_scope_bypass_permissions();
}

/**
 * Implements hook_uninstall().
 *
 * Removes Beantragt group scope base fields from scoped entity types.
 */
function beantragt_group_uninstall(): void {
  $update_manager = \Drupal::entityDefinitionUpdateManager();
  $entity_types = ['form_schema', 'form_schema_group', 'application', 'applicant'];

  foreach ($entity_types as $entity_type_id) {
    foreach (['field_jurisdiction', 'field_organisation', 'field_group'] as $field_name) {
      $field_storage = $update_manager->getFieldStorageDefinition($field_name, $entity_type_id);
      if ($field_storage) {
        $update_manager->uninstallFieldStorageDefinition($field_storage);
        \Drupal::logger('beantragt_group')->info(
          'Removed @field base field from @type.',
          [
            '@field' => $field_name,
            '@type' => $entity_type_id,
          ]
        );
      }
    }
  }
}

/**
 * Implements hook_schema().
 */
function beantragt_group_schema(): array {
  $schema['beantragt_group_invitations'] = _beantragt_group_invitation_schema();

  return $schema;
}

/**
 * Install field_group base field on applicant entity type.
 */
function beantragt_group_update_10001(): string {
  $update_manager = \Drupal::entityDefinitionUpdateManager();
  $entity_type_id = 'applicant';
  $entity_type_manager = \Drupal::entityTypeManager();

  if (!$entity_type_manager->hasDefinition($entity_type_id)) {
    return 'applicant entity type not found.';
  }

  $entity_type = $entity_type_manager->getDefinition($entity_type_id);

  $field_definitions = beantragt_group_entity_base_field_info($entity_type);
  if (isset($field_definitions['field_group'])) {
    $field_definitions['field_group']->setName('field_group');
    $field_definitions['field_group']->setTargetEntityTypeId($entity_type_id);
    if (!$update_manager->getFieldStorageDefinition('field_group', $entity_type_id)) {
      $update_manager->installFieldStorageDefinition(
        'field_group',
        $entity_type_id,
        'beantragt_group',
        $field_definitions['field_group']
      );
      return 'Installed field_group base field on applicant.';
    }
  }

  return 'field_group already exists on applicant.';
}

/**
 * Add field_reference_pattern to org group type.
 *
 * This field stores the configurable reference number pattern per
 * organisation. Tokens: {ORG}, {YEAR}, {SEQ}, {SEQ:N}, {FORM_CODE},
 * {UUID_SHORT}. Default pattern: "{ORG}-{YEAR}-{SEQ:5}".
 */
function beantragt_group_update_10002(): string {
  $messages = [];
  $entity_type_manager = \Drupal::entityTypeManager();

  // Create field storage if it does not exist.
  $field_storage_config = $entity_type_manager->getStorage('field_storage_config');
  $storage = $field_storage_config->load('group.field_reference_pattern');
  if (!$storage) {
    $storage = $field_storage_config->create([
      'field_name' => 'field_reference_pattern',
      'entity_type' => 'group',
      'type' => 'string',
      'settings' => [
        'max_length' => 128,
        'is_ascii' => TRUE,
        'case_sensitive' => FALSE,
      ],
      'cardinality' => 1,
      'translatable' => FALSE,
    ]);
    $storage->save();
    $messages[] = 'Created field_reference_pattern field storage.';
  }

  // Create field instance on org bundle if it does not exist.
  $field_config = $entity_type_manager->getStorage('field_config');
  $field = $field_config->load('group.org.field_reference_pattern');
  if (!$field) {
    $field = $field_config->create([
      'field_name' => 'field_reference_pattern',
      'entity_type' => 'group',
      'bundle' => 'org',
      'label' => 'Aktenzeichen-Muster',
      'description' => 'Muster fuer Vorgangsnummern. Tokens: {ORG}, {YEAR}, {SEQ}, {SEQ:N} (N = Ziffern), {FORM_CODE}, {UUID_SHORT}. Beispiel: "{ORG}-{YEAR}-{SEQ:5}" ergibt "FRE-2026-00001". Leer lassen fuer Standard-Muster.',
      'required' => FALSE,
      'default_value' => [
        ['value' => '{ORG}-{YEAR}-{SEQ:5}'],
      ],
    ]);
    $field->save();
    $messages[] = 'Created field_reference_pattern field on org group type.';
  }
  else {
    $messages[] = 'field_reference_pattern already exists on org group type.';
  }

  return implode(' ', $messages);
}

/**
 * Add field_slug to jur and org group types.
 *
 * URL-safe slug for hierarchical routing:
 * /kreis-slug/stadt-slug/amt-slug.
 *
 * Must be unique per bundle, lowercase, alphanumeric + hyphens.
 */
function beantragt_group_update_10003(): string {
  $entity_type_manager = \Drupal::entityTypeManager();
  $messages = _beantragt_group_ensure_slug_field($entity_type_manager);

  // Backfill slugs for existing groups (generate from label).
  $group_storage = $entity_type_manager->getStorage('group');
  $groups = $group_storage->loadMultiple();
  $backfilled = 0;
  foreach ($groups as $group) {
    if ($group->hasField('field_slug') && $group->get('field_slug')->isEmpty()) {
      $slug = _beantragt_group_slugify($group->label() ?? '');
      if ($slug) {
        $group->set('field_slug', $slug);
        $group->save();
        $backfilled++;
      }
    }
  }
  if ($backfilled > 0) {
    $messages[] = "Backfilled slugs for $backfilled existing groups.";
  }

  return implode(' ', $messages);
}

/**
 * Adds explicit jurisdiction and organisation base fields.
 */
function beantragt_group_update_10004(): string {
  $messages = _beantragt_group_install_scope_field_storages();
  $messages[] = 'Skipped historical data backfill.';

  return implode(' ', $messages);
}

/**
 * Ensures scope bypass is limited to trusted platform administrators.
 */
function beantragt_group_update_10005(): string {
  $messages = [];
  if (_beantragt_group_ensure_scope_bypass_permissions()) {
    $messages[] = 'Ensured Beantragt group scope bypass permissions.';
  }
  else {
    $messages[] = 'No trusted platform roles found for Beantragt group scope bypass.';
  }

  // Until 15.11.2026 this hook also added every administrator and
  // department_admin to every group. It no longer writes memberships.
  return implode(' ', $messages);
}

/**
 * Grant scope bypass to trusted platform roles.
 */
function beantragt_group_update_10006(): string {
  return _beantragt_group_ensure_scope_bypass_permissions()
    ? 'Ensured Beantragt group scope bypass permissions.'
    : 'No trusted platform roles found for Beantragt group scope bypass.';
}

/**
 * Installs and backfills form schema group scope fields.
 */
function beantragt_group_update_10007(): string {
  $messages = _beantragt_group_install_scope_field_storages();
  $entity_type_manager = \Drupal::entityTypeManager();

  if (!$entity_type_manager->hasDefinition('form_schema_group')) {
    $messages[] = 'form_schema_group entity type not found.';
    return implode(' ', $messages);
  }

  $storage = $entity_type_manager->getStorage('form_schema_group');
  $ids = $storage->getQuery()
    ->accessCheck(FALSE)
    ->execute();
  $backfilled = 0;

  foreach ($storage->loadMultiple($ids) as $schema_group) {
    if (!$schema_group instanceof EntityInterface
      || !_beantragt_group_entity_scope_is_empty($schema_group)
      || !$schema_group->hasField('field_schemas')
      || $schema_group->get('field_schemas')->isEmpty()) {
      continue;
    }

    $schemas = $schema_group->get('field_schemas')->referencedEntities();
    $first_schema = reset($schemas);
    if (!$first_schema instanceof EntityInterface) {
      continue;
    }

    _beantragt_group_copy_scope_from_schema($schema_group, $first_schema, TRUE);
    _beantragt_group_normalize_scope_fields($schema_group);
    _beantragt_group_assert_related_schemas_share_scope($schema_group, $schemas);
    if (!_beantragt_group_entity_scope_is_empty($schema_group)) {
      $schema_group->save();
      $backfilled++;
    }
  }

  $messages[] = sprintf('Backfilled scope on %d form schema groups.', $backfilled);

  return implode(' ', $messages);
}

