/**
 * Gives editorial office reference fields German labels.
 */
function beantragt_content_update_10017(): void {
  _beantragt_content_label_office_fields_in_german();
}

/**
 * Sets the German office label alongside each editorial field configuration.
 */
function _beantragt_content_label_office_fields_in_german(): void {
  $language_manager = \Drupal::languageManager();
  if (!$language_manager instanceof ConfigurableLanguageManagerInterface) {
    return;
  }
  foreach (['page', 'boilerplate', 'public_document', 'content_section'] as $bundle) {
    $name = "field.field.node.$bundle.field_organisation";
    $base = \Drupal::configFactory()->getEditable($name);
    $override = $language_manager->getLanguageConfigOverride('de', $name);
    if (($override->get('label') ?? $base->get('label')) === 'Organisation') {
      $override->set('label', 'Dienststelle')->save();
    }
  }
}

/**
 * Moves legacy footer sections and documents to the form sidebar.
 */
function beantragt_content_update_10016(): string {
  $manager = \Drupal::entityTypeManager();
  $placement = $manager->getStorage('field_storage_config')->load('node.field_content_placement');
  if (!$placement instanceof FieldStorageConfigInterface) {
    return 'No public content placement field to update.';
  }

  // Update shared field data in place, including pending and older revisions
  // that could otherwise restore the retired value when reverted.
  $database = \Drupal::database();
  $bundles = ['content_section', 'public_document'];
  $changed_ids = [];
  foreach (['node__field_content_placement', 'node_revision__field_content_placement'] as $table) {
    $ids = $database->select($table, 'placement')->distinct()
      ->fields('placement', ['entity_id'])
      ->condition('bundle', $bundles, 'IN')
      ->condition('deleted', 0)
      ->condition('field_content_placement_value', 'footer')
      ->execute()->fetchCol();
    $changed_ids = array_merge($changed_ids, $ids);
    $database->update($table)
      ->fields(['field_content_placement_value' => 'form_sidebar'])
      ->condition('bundle', $bundles, 'IN')
      ->condition('deleted', 0)
      ->condition('field_content_placement_value', 'footer')
      ->execute();
  }

  $values = $placement->getSetting('allowed_values');
  $remove_footer = isset($values['footer']);
  if ($changed_ids !== []) {
    $ids = array_unique($changed_ids);
    $manager->getStorage('node')->resetCache($ids);
    Cache::invalidateTags(Cache::buildTags('node', $ids, ':'));
  }
  if ($changed_ids !== [] || $remove_footer) {
    Cache::invalidateTags(['node_list', 'node_list:content_section', 'node_list:public_document']);
  }
  if ($remove_footer) {
    unset($values['footer']);
    $placement->setSetting('allowed_values', $values)->save();
  }

  return 'Legacy footer placements moved to the form sidebar.';
}

/**
 * Ensures page and boilerplate content types plus scope fields exist.
 *
 * @return string[]
 *   Human-readable changes.
 */
function _beantragt_content_ensure_content_model(EntityTypeManagerInterface $entity_type_manager): array {
  $messages = [];
  $type_storage = $entity_type_manager->getStorage('node_type');

  if (!$type_storage->load('page')) {
    $type_storage->create([
      'type' => 'page',
      'name' => 'Basic page',
      'description' => 'Static public content pages such as privacy policy and legal notice.',
      'help' => '',
      'new_revision' => TRUE,
      'preview_mode' => 1,
      'display_submitted' => FALSE,
    ])->save();
    $messages[] = 'Created page content type.';
  }

  if (!$type_storage->load('boilerplate')) {
    $type_storage->create([
      'type' => 'boilerplate',
      'name' => 'Boilerplate',
      'description' => 'Reusable text templates for status notes and internal workflows.',
      'help' => '',
      'new_revision' => TRUE,
      'preview_mode' => 1,
      'display_submitted' => FALSE,
    ])->save();
    $messages[] = 'Created boilerplate content type.';
  }

  if (!$type_storage->load('public_document')) {
    $type_storage->create([
      'type' => 'public_document',
      'name' => 'Public document',
      'description' => 'Editorial public downloads such as leaflets, fee sheets and form instructions.',
      'help' => '',
      'new_revision' => TRUE,
      'preview_mode' => 1,
      'display_submitted' => FALSE,
    ])->save();
    $messages[] = 'Created public_document content type.';
  }

  if (!$type_storage->load('content_section')) {
    $type_storage->create([
      'type' => 'content_section',
      'name' => 'Content section',
      'description' => 'Editorial public HTML sections for organisation starts, form intros, sidebars and submission success pages.',
      'help' => '',
      'new_revision' => TRUE,
      'preview_mode' => 1,
      'display_submitted' => FALSE,
    ])->save();
    $messages[] = 'Created content_section content type.';
  }

  $messages = array_merge(
    $messages,
    _beantragt_content_ensure_field_storages($entity_type_manager),
    _beantragt_content_ensure_page_fields($entity_type_manager),
    _beantragt_content_ensure_boilerplate_fields($entity_type_manager),
    _beantragt_content_ensure_public_document_fields($entity_type_manager),
    _beantragt_content_ensure_content_section_fields($entity_type_manager),
  );

  return $messages;
}

/**
 * Ensures shared node field storages exist.
 *
 * @return string[]
 *   Human-readable changes.
 */
function _beantragt_content_ensure_field_storages(EntityTypeManagerInterface $entity_type_manager): array {
  $messages = [];
  $field_storage = $entity_type_manager->getStorage('field_storage_config');

  if (!$field_storage->load('node.body')) {
    $field_storage->create([
      'field_name' => 'body',
      'entity_type' => 'node',
      'type' => 'text_with_summary',
      'module' => 'text',
      'cardinality' => 1,
      'translatable' => TRUE,
      'settings' => [],
    ])->save();
    $messages[] = 'Created node.body field storage.';
  }

  if (!$field_storage->load('node.field_jurisdiction')) {
    $field_storage->create([
      'field_name' => 'field_jurisdiction',
      'entity_type' => 'node',
      'type' => 'entity_reference',
      'settings' => [
        'target_type' => 'group',
      ],
      'module' => 'core',
      'cardinality' => 1,
      'translatable' => FALSE,
    ])->save();
    $messages[] = 'Created node.field_jurisdiction field storage.';
  }

  if (!$field_storage->load('node.field_organisation')) {
    $field_storage->create([
      'field_name' => 'field_organisation',
      'entity_type' => 'node',
      'type' => 'entity_reference',
      'settings' => [
        'target_type' => 'group',
      ],
      'module' => 'core',
      'cardinality' => 1,
      'translatable' => FALSE,
    ])->save();
    $messages[] = 'Created node.field_organisation field storage.';
  }

  if (!$field_storage->load('node.field_page_key')) {
    $field_storage->create([
      'field_name' => 'field_page_key',
      'entity_type' => 'node',
      'type' => 'list_string',
      'settings' => [
        'allowed_values' => _beantragt_content_page_key_allowed_values(),
        'allowed_values_function' => '',
      ],
      'module' => 'options',
      'cardinality' => 1,
      'translatable' => FALSE,
    ])->save();
    $messages[] = 'Created node.field_page_key field storage.';
  }
  else {
    $messages = array_merge($messages, _beantragt_content_ensure_allowed_values(
      $entity_type_manager,
      'node.field_page_key',
      _beantragt_content_page_key_allowed_values(),
    ));
  }

  if (!$field_storage->load('node.field_public_slug')) {
    $field_storage->create([
      'field_name' => 'field_public_slug',
      'entity_type' => 'node',
      'type' => 'string',
      'settings' => [
        'max_length' => 128,
        'is_ascii' => TRUE,
        'case_sensitive' => FALSE,
      ],
      'module' => 'core',
      'cardinality' => 1,
      'translatable' => TRUE,
    ])->save();
    $messages[] = 'Created node.field_public_slug field storage.';
  }

  if (!$field_storage->load('node.field_footer_visible')) {
    $field_storage->create([
      'field_name' => 'field_footer_visible',
      'entity_type' => 'node',
      'type' => 'boolean',
      'settings' => [],
      'module' => 'core',
      'cardinality' => 1,
      'translatable' => FALSE,
    ])->save();
    $messages[] = 'Created node.field_footer_visible field storage.';
  }

  if (!$field_storage->load('node.field_page_weight')) {
    $field_storage->create([
      'field_name' => 'field_page_weight',
      'entity_type' => 'node',
      'type' => 'integer',
      'settings' => [
        'unsigned' => FALSE,
        'size' => 'normal',
      ],
      'module' => 'core',
      'cardinality' => 1,
      'translatable' => FALSE,
    ])->save();
    $messages[] = 'Created node.field_page_weight field storage.';
  }

  if (!$field_storage->load('node.field_boilerplate_type')) {
    $field_storage->create([
      'field_name' => 'field_boilerplate_type',
      'entity_type' => 'node',
      'type' => 'list_string',
      'settings' => [
        'allowed_values' => [
          'status_notes' => 'Status notes',
          'service_provider' => 'Service provider',
          'remarks' => 'Remarks',
        ],
        'allowed_values_function' => '',
      ],
      'module' => 'options',
      'cardinality' => 1,
      'translatable' => FALSE,
    ])->save();
    $messages[] = 'Created node.field_boilerplate_type field storage.';
  }

  if (!$field_storage->load('node.field_public_document_file')) {
    $field_storage->create([
      'field_name' => 'field_public_document_file',
      'entity_type' => 'node',
      'type' => 'file',
      'settings' => [
        'target_type' => 'file',
        'display_field' => FALSE,
        'display_default' => FALSE,
      ],
      'module' => 'file',
      'cardinality' => 1,
      'translatable' => FALSE,
    ])->save();
    $messages[] = 'Created node.field_public_document_file field storage.';
  }

  if (!$field_storage->load('node.field_form_schema')) {
    $field_storage->create([
      'field_name' => 'field_form_schema',
      'entity_type' => 'node',
      'type' => 'entity_reference',
      'settings' => [
        'target_type' => 'form_schema',
      ],
      'module' => 'core',
      'cardinality' => 1,
      'translatable' => FALSE,
    ])->save();
    $messages[] = 'Created node.field_form_schema field storage.';
  }

  if (!$field_storage->load('node.field_content_placement')) {
    $field_storage->create([
      'field_name' => 'field_content_placement',
      'entity_type' => 'node',
      'type' => 'list_string',
      'settings' => [
        'allowed_values' => _beantragt_content_placement_allowed_values(),
        'allowed_values_function' => '',
      ],
      'module' => 'options',
      'cardinality' => 1,
      'translatable' => FALSE,
    ])->save();
    $messages[] = 'Created node.field_content_placement field storage.';
  }
  else {
    $messages = array_merge($messages, _beantragt_content_ensure_allowed_values(
      $entity_type_manager,
      'node.field_content_placement',
      _beantragt_content_placement_allowed_values(),
    ));
  }

  if (!$field_storage->load('node.field_content_weight')) {
    $field_storage->create([
      'field_name' => 'field_content_weight',
      'entity_type' => 'node',
      'type' => 'integer',
      'settings' => [
        'unsigned' => FALSE,
        'size' => 'normal',
      ],
      'module' => 'core',
      'cardinality' => 1,
      'translatable' => FALSE,
    ])->save();
    $messages[] = 'Created node.field_content_weight field storage.';
  }

  return $messages;
}

