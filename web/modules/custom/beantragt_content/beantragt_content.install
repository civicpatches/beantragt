/**
 * Finds a suitable published internet demo form schema.
 */
function _beantragt_content_find_demo_form_schema(
  EntityTypeManagerInterface $entity_type_manager,
  GroupInterface $jurisdiction,
  ?GroupInterface $organisation,
): ?EntityInterface {
  if (!$entity_type_manager->hasDefinition('form_schema')) {
    return NULL;
  }

  $storage = $entity_type_manager->getStorage('form_schema');
  $build_query = static function (?string $label_prefix) use ($storage, $jurisdiction, $organisation): QueryInterface {
    $query = $storage->getQuery()
      ->accessCheck(FALSE)
      ->condition('status', 1)
      ->condition('field_workflow_status', 'published')
      ->condition('field_publication_scope', 'internet')
      ->condition('field_jurisdiction.target_id', (int) $jurisdiction->id())
      ->sort('changed', 'DESC')
      ->range(0, 1);
    if ($organisation instanceof GroupInterface) {
      $query->condition('field_organisation.target_id', (int) $organisation->id());
    }
    if ($label_prefix !== NULL) {
      $query->condition('label', $label_prefix . '%', 'LIKE');
    }
    return $query;
  };

  $ids = $build_query('Smoke Antrag:')->execute();
  if (!$ids) {
    $ids = $build_query(NULL)->execute();
  }
  if (!$ids) {
    return NULL;
  }

  $entity = $storage->load((string) reset($ids));

  return $entity instanceof EntityInterface ? $entity : NULL;
}

/**
 * Ensures the local public demo PDF exists as a private file entity.
 */
function _beantragt_content_ensure_demo_public_document_file(EntityTypeManagerInterface $entity_type_manager): ?FileInterface {
  $uri = 'private://public_documents/musterstadt-merkblatt.pdf';
  $file_storage = $entity_type_manager->getStorage('file');
  $existing = $file_storage->loadByProperties(['uri' => $uri]);
  $file = reset($existing);
  if ($file instanceof FileInterface) {
    return $file;
  }

  /** @var \Drupal\Core\File\FileSystemInterface $file_system */
  $file_system = \Drupal::service('file_system');
  $directory = 'private://public_documents';
  if (!$file_system->prepareDirectory($directory, FileSystemInterface::CREATE_DIRECTORY | FileSystemInterface::MODIFY_PERMISSIONS)) {
    return NULL;
  }

  $content_stream = 'BT /F1 12 Tf 24 96 Td (Merkblatt Antragstellung Musterstadt) Tj'
    . " 0 -18 Td (Halten Sie die im Formular genannten) Tj 0 -14 Td (Unterlagen bereit.) Tj ET\n";
  $objects = [
    "1 0 obj << /Type /Catalog /Pages 2 0 R >> endobj\n",
    "2 0 obj << /Type /Pages /Kids [3 0 R] /Count 1 >> endobj\n",
    "3 0 obj << /Type /Page /Parent 2 0 R /MediaBox [0 0 360 144] /Resources << /Font << /F1 5 0 R >> >> /Contents 4 0 R >> endobj\n",
    sprintf("4 0 obj << /Length %d >> stream\n%sendstream endobj\n", strlen($content_stream), $content_stream),
    "5 0 obj << /Type /Font /Subtype /Type1 /BaseFont /Helvetica /Encoding /WinAnsiEncoding >> endobj\n",
  ];
  $pdf = "%PDF-1.4\n";
  $offsets = [];
  foreach ($objects as $object) {
    $offsets[] = strlen($pdf);
    $pdf .= $object;
  }
  $xref_offset = strlen($pdf);
  $pdf .= sprintf("xref\n0 %d\n0000000000 65535 f \n", count($objects) + 1);
  foreach ($offsets as $offset) {
    $pdf .= sprintf("%010d 00000 n \n", $offset);
  }
  $pdf .= sprintf(
    "trailer << /Root 1 0 R /Size %d >>\nstartxref\n%d\n%%%%EOF\n",
    count($objects) + 1,
    $xref_offset,
  );

  $repository = \Drupal::service('file.repository');
  $file = $repository->writeData($pdf, $uri, FileExists::Replace);
  $file->setPermanent();
  $file->save();

  return $file;
}

/**
 * Migrates referenced public document files from public:// to private://.
 *
 * @return string[]
 *   Human-readable changes.
 */
function _beantragt_content_migrate_public_document_files_to_private(EntityTypeManagerInterface $entity_type_manager): array {
  $messages = [];
  if (!$entity_type_manager->hasDefinition('node')) {
    return $messages;
  }

  $node_storage = $entity_type_manager->getStorage('node');
  $ids = $node_storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', 'public_document')
    ->exists('field_public_document_file')
    ->execute();
  if (!$ids) {
    return $messages;
  }

  /** @var \Drupal\Core\File\FileSystemInterface $file_system */
  $file_system = \Drupal::service('file_system');
  $directory = 'private://public_documents';
  if (!$file_system->prepareDirectory($directory, FileSystemInterface::CREATE_DIRECTORY | FileSystemInterface::MODIFY_PERMISSIONS)) {
    return ['Skipped public document file migration because private directory could not be prepared.'];
  }

  $file_storage = $entity_type_manager->getStorage('file');
  $repository = \Drupal::service('file.repository');
  $migrated = 0;
  /** @var \Drupal\node\NodeInterface[] $nodes */
  $nodes = $node_storage->loadMultiple($ids);
  foreach ($nodes as $node) {
    if (!$node->hasField('field_public_document_file') || $node->get('field_public_document_file')->isEmpty()) {
      continue;
    }
    $file = $node->get('field_public_document_file')->entity ?? NULL;
    if (!$file instanceof FileInterface) {
      continue;
    }
    $uri = (string) $file->getFileUri();
    if (!str_starts_with($uri, 'public://public_documents/')) {
      continue;
    }
    $filename = basename(substr($uri, strlen('public://public_documents/')));
    if ($filename === '' || str_contains($filename, '/') || str_contains($filename, '\\') || str_contains($filename, '..')) {
      continue;
    }
    $data = @file_get_contents($uri);
    if (!is_string($data) || $data === '') {
      continue;
    }
    $new_file = $repository->writeData($data, $directory . '/' . $filename, FileExists::Rename);
    $new_file->setPermanent();
    $new_file->setOwnerId((int) $file->getOwnerId());
    $new_file->save();
    $node->set('field_public_document_file', ['target_id' => $new_file->id()]);
    $node->save();
    try {
      $file->delete();
    }
    catch (\Throwable) {
      // The node no longer references the public file. Ignore cleanup failures.
    }
    $migrated++;
  }

  if ($migrated > 0) {
    $messages[] = sprintf('Migrated %d public document file(s) to private storage.', $migrated);
  }

  $legacy = $file_storage->loadByProperties(['uri' => 'public://public_documents/musterstadt-merkblatt.pdf']);
  foreach ($legacy as $file) {
    try {
      $file->delete();
    }
    catch (\Throwable) {
      // Best-effort cleanup for old demo artifacts.
    }
  }

  return $messages;
}

/**
 * Ensures one jurisdiction-scoped status-note boilerplate exists.
 */
function _beantragt_content_ensure_boilerplate(
  EntityTypeManagerInterface $entity_type_manager,
  GroupInterface $jurisdiction,
  string $de_title,
  string $de_body,
  string $en_title,
  string $en_body,
  array $legacy_titles = [],
): string {
  $node = _beantragt_content_find_node_by_titles($entity_type_manager, 'boilerplate', $jurisdiction, array_values(array_unique([
    $de_title,
    $en_title,
    ...$legacy_titles,
  ])));
  if (!$node instanceof NodeInterface) {
    $node = $entity_type_manager->getStorage('node')->create([
      'type' => 'boilerplate',
      'langcode' => _beantragt_content_source_langcode(),
      'status' => 1,
    ]);
  }

  _beantragt_content_set_localized_body($node, $de_title, $de_body, $en_title, $en_body);
  if ($node->hasField('field_boilerplate_type')) {
    $node->set('field_boilerplate_type', 'status_notes');
  }
  if ($node->hasField('field_jurisdiction')) {
    $node->set('field_jurisdiction', ['target_id' => $jurisdiction->id()]);
  }
  if ($node->hasField('field_organisation')) {
    $node->set('field_organisation', NULL);
  }
  return _beantragt_content_save_demo_node($node, 'boilerplate', $de_title);
}

/**
 * Saves a demo node only when new or changed in any language.
 */
function _beantragt_content_save_demo_node(NodeInterface $node, string $kind, string $label): string {
  $created = $node->isNew();
  foreach ($node->getTranslationLanguages() as $langcode => $language) {
    if ($node->getTranslation($langcode)->hasTranslationChanges()) {
      $node->save();
      return sprintf('%s %s "%s".', $created ? 'Created' : 'Updated', $kind, $label);
    }
  }

  return '';
}

/**
 * Finds one scoped node by title, including legacy seed titles.
 */
function _beantragt_content_find_node_by_titles(
  EntityTypeManagerInterface $entity_type_manager,
  string $bundle,
  GroupInterface $jurisdiction,
  array $titles,
): ?NodeInterface {
  $titles = array_values(array_filter($titles, static fn(string $title): bool => $title !== ''));
  if ($titles === []) {
    return NULL;
  }

  $query = $entity_type_manager->getStorage('node')->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', $bundle)
    ->condition('field_jurisdiction.target_id', (int) $jurisdiction->id())
    ->range(0, 1);

  if (count($titles) === 1) {
    $query->condition('title', $titles[0]);
  }
  else {
    $query->condition('title', $titles, 'IN');
  }

  $ids = $query->execute();
  if (!$ids) {
    return NULL;
  }

  $node = $entity_type_manager->getStorage('node')->load((string) reset($ids));

  return $node instanceof NodeInterface ? $node : NULL;
}

/**
 * Finds one scoped node.
 */
function _beantragt_content_find_node(
  EntityTypeManagerInterface $entity_type_manager,
  string $bundle,
  GroupInterface $jurisdiction,
  string $key_field,
  string $key_value,
  bool $jurisdiction_default_only = FALSE,
): ?NodeInterface {
  $query = $entity_type_manager->getStorage('node')->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', $bundle)
    ->condition('field_jurisdiction.target_id', (int) $jurisdiction->id())
    ->range(0, 1);

  if ($key_field === 'title') {
    $query->condition('title', $key_value);
  }
  else {
    $query->condition($key_field, $key_value);
  }

  if ($jurisdiction_default_only) {
    $query->notExists('field_organisation');
  }

  $ids = $query->execute();
  if (!$ids) {
    return NULL;
  }

  $node = $entity_type_manager->getStorage('node')->load((string) reset($ids));

  return $node instanceof NodeInterface ? $node : NULL;
}

/**
 * Sets source and English translation content on a node.
 */
function _beantragt_content_set_localized_body(
  NodeInterface $node,
  string $de_title,
  string $de_body,
  string $en_title,
  string $en_body,
): void {
  $source_langcode = $node->language()->getId();
  $source_title = $source_langcode === 'de' ? $de_title : $en_title;
  $source_body = $source_langcode === 'de' ? $de_body : $en_body;

  $node->set('title', $source_title);
  if ($node->hasField('body')) {
    $node->set('body', [
      'value' => $source_body,
      'format' => 'basic_html',
    ]);
  }

  foreach (['de' => [$de_title, $de_body], 'en' => [$en_title, $en_body]] as $langcode => [$title, $body]) {
    if ($langcode === $source_langcode || !_beantragt_content_language_exists($langcode)) {
      continue;
    }
    $translation = $node->hasTranslation($langcode)
      ? $node->getTranslation($langcode)
      : $node->addTranslation($langcode);
    $translation->set('title', $title);
    if ($translation->hasField('body')) {
      $translation->set('body', [
        'value' => $body,
        'format' => 'basic_html',
      ]);
    }
  }
}

/**
 * Sets source and translated public slugs on a page node.
 */
function _beantragt_content_set_localized_public_slug(
  NodeInterface $node,
  string $de_slug,
  string $en_slug,
): void {
  if (!$node->hasField('field_public_slug')) {
    return;
  }

  $source_langcode = $node->language()->getId();
  $source_slug = $source_langcode === 'de' ? $de_slug : $en_slug;
  $node->set('field_public_slug', _beantragt_content_normalize_public_slug($source_slug));

  foreach (['de' => $de_slug, 'en' => $en_slug] as $langcode => $slug) {
    if ($langcode === $source_langcode || !_beantragt_content_language_exists($langcode)) {
      continue;
    }

    $translation = $node->hasTranslation($langcode)
      ? $node->getTranslation($langcode)
      : $node->addTranslation($langcode);
    if ($translation->hasField('field_public_slug')) {
      $translation->set('field_public_slug', _beantragt_content_normalize_public_slug($slug));
    }
  }
}

/**
 * Normalizes seed route slugs.
 */
function _beantragt_content_normalize_public_slug(string $slug): string {
  return strtolower(trim($slug));
}

/**
 * Returns the preferred source langcode for seeded content.
 */
function _beantragt_content_source_langcode(): string {
  return _beantragt_content_language_exists('de')
    ? 'de'
    : \Drupal::languageManager()->getDefaultLanguage()->getId();
}

/**
 * Checks whether a configurable language exists.
 */
function _beantragt_content_language_exists(string $langcode): bool {
  return isset(\Drupal::languageManager()->getLanguages()[$langcode]);
}
