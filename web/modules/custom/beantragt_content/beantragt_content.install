/**
 * Implements hook_install().
 */
function beantragt_content_install(): void {
  $entity_type_manager = \Drupal::entityTypeManager();
  _beantragt_content_ensure_content_model($entity_type_manager);
  _beantragt_content_label_office_fields_in_german();
}

/**
 * Installs page and boilerplate content model on existing sites.
 */
function beantragt_content_update_10001(): string {
  $messages = _beantragt_content_ensure_content_model(\Drupal::entityTypeManager());
  $messages[] = 'Content model ready.';

  return implode(' ', array_filter($messages));
}

