/**
 * Restricts a node bundle body field to sanitized basic HTML.
 *
 * @return string[]
 *   Human-readable changes.
 */
function _beantragt_content_restrict_body_formats(EntityTypeManagerInterface $entity_type_manager, string $bundle): array {
  $field = $entity_type_manager->getStorage('field_config')->load('node.' . $bundle . '.body');
  if (!$field instanceof FieldConfigInterface) {
    return [];
  }

  $settings = $field->get('settings') ?? [];
  if (($settings['allowed_formats'] ?? NULL) === ['basic_html']) {
    return [];
  }

  $settings['allowed_formats'] = ['basic_html'];
  $field->set('settings', $settings);
  $field->save();

  return [sprintf('Restricted %s body to basic_html.', $bundle)];
}

/**
 * Seeds the example content for Musterstadt when explicitly enabled.
 *
 * @return string[]
 *   Human-readable changes.
 */
function _beantragt_content_seed_demo_content(
  EntityTypeManagerInterface $entity_type_manager,
  bool $local_example = FALSE,
): array {
  if (getenv('BEANTRAGT_ALLOW_CONTENT_DEMO_SEED') !== '1') {
    return ['Skipped demo content seed because BEANTRAGT_ALLOW_CONTENT_DEMO_SEED is not 1.'];
  }

  $messages = [];
  $jurisdiction = _beantragt_content_find_group_by_slug('jur', 'musterstadt');
  if (!$jurisdiction instanceof GroupInterface) {
    return ['Skipped content seed because Musterstadt jurisdiction is missing.'];
  }

  $messages[] = _beantragt_content_ensure_page(
    $entity_type_manager,
    $jurisdiction,
    'accessibility',
    'barrierefreiheit',
    'Barrierefreiheitserklärung',
    <<<'HTML'
    <p>Musterstadt ist eine fiktive Beispielinstallation zum Ausprobieren von Online-Anträgen.</p>
    <p>Eine Prüfung der Barrierefreiheit dieser Installation liegt nicht vor. Informationen zum Einstieg finden Sie unter <a href="/musterstadt/pages/leichte-sprache">Informationen in Leichter Sprache</a>.</p>
    <p>Wenden Sie sich bei Fragen zur Barrierefreiheit an die Betreiberin oder den Betreiber Ihrer Installation.</p>
    HTML,
    'accessibility',
    'Accessibility statement',
    <<<'HTML'
    <p>Musterstadt is a fictional example installation for trying online applications.</p>
    <p>The accessibility of this installation has not been assessed. See the <a href="/musterstadt/pages/easy-language?lang=en">information in easy language</a> for help getting started.</p>
    <p>Contact the operator of your installation with accessibility questions.</p>
    HTML,
    30,
    preserve_existing: TRUE,
  );

  $messages[] = _beantragt_content_ensure_page(
    $entity_type_manager,
    $jurisdiction,
    'easy_language',
    'leichte-sprache',
    'Informationen in Leichter Sprache',
    <<<'HTML'
    <p>Musterstadt ist eine erfundene Stadt.<br>Auf dieser Seite können Sie Anträge üben.</p>
    <h2>So stellen Sie einen Antrag</h2>
    <p>Wählen Sie ein Formular aus.<br>Füllen Sie die Felder aus.<br>Manchmal braucht das Formular Dateien.<br>Laden Sie diese Dateien hoch.<br>Senden Sie den Antrag ab.</p>
    <p>Sie bekommen ein Aktenzeichen.<br>Das Aktenzeichen ist eine Nummer für Ihren Antrag.<br>Mit der Nummer können Sie nachsehen, was mit Ihrem Antrag passiert.</p>
    <h2>Hilfe bei Problemen mit der Seite</h2>
    <p>Manche Teile der Seite sind schwer zu benutzen.<br>Zum Beispiel können Vorlese-Programme manche Dateien nicht vorlesen.<br>Mehr dazu steht in der <a href="/musterstadt/pages/barrierefreiheit">Erklärung zur Barriere-Freiheit</a>.</p>
    <p>Haben Sie ein Problem mit der Seite?<br>Fragen Sie die Person, die diese Seite für Sie bereitstellt.<br>Schreiben Sie, auf welcher Seite das Problem ist.</p>
    HTML,
    'easy-language',
    'Easy-Language Information',
    <<<'HTML'
    <p>Musterstadt is a fictional town.<br>You can practise sending applications on this website.</p>
    <h2>How to send an application</h2>
    <p>Choose a form.<br>Fill in the fields.<br>Some forms ask for files.<br>Upload the files the form asks for.<br>Send the application.</p>
    <p>You get a reference number.<br>This is a number for your application.<br>Use it to check what happens to your application.</p>
    <h2>Help with using the website</h2>
    <p>Some parts of the site are hard to use.<br>For example, screen readers cannot read some files aloud.<br>Find out more in the <a href="/musterstadt/pages/accessibility?lang=en">accessibility statement</a>.</p>
    <p>Do you have a problem using the website?<br>Ask the person who runs this site for you.<br>Tell us which page you had trouble using.</p>
    HTML,
    40,
  );

  $messages[] = _beantragt_content_ensure_page(
    $entity_type_manager,
    $jurisdiction,
    'sign_language',
    'gebaerdensprache',
    'Informationen in Gebärdensprache',
    <<<'HTML'
    <p><strong>Die Beispielinstallation Musterstadt enthält kein Video in Deutscher Gebärdensprache (DGS).</strong></p>
    <p>In der Beispielinstallation können Sie Online-Anträge in einer erfundenen Stadt ausprobieren. Die <a href="/musterstadt/pages/leichte-sprache">Informationen in Leichter Sprache</a> erklären den Einstieg in Textform. In der <a href="/musterstadt/pages/barrierefreiheit">Barrierefreiheitserklärung</a> stehen die bekannten Barrieren und der Kontakt, an den Sie sich bei Fragen wenden können.</p>
    HTML,
    'sign-language',
    'Sign-Language Information',
    <<<'HTML'
    <p><strong>The Musterstadt example has no video in German Sign Language (DGS).</strong></p>
    <p>The example lets you try online applications in a fictional town. The <a href="/musterstadt/pages/easy-language?lang=en">information in easy language</a> is a written guide to getting started. The <a href="/musterstadt/pages/accessibility?lang=en">accessibility statement</a> describes known barriers and tells you who to contact if you have questions.</p>
    HTML,
    50,
  );

  $organisation = _beantragt_content_find_group_by_slug('org', 'citizen-services');
  if (!$organisation instanceof GroupInterface
    || !$organisation->hasField('field_jurisdiction')
    || (int) ($organisation->get('field_jurisdiction')->target_id ?? 0) !== (int) $jurisdiction->id()) {
    $organisation = NULL;
  }
  // The local installation has multiple published forms in the Bürgerbüro.
  // Its general guidance belongs to the office, independent of form revisions.
  $form_schema = $local_example ? NULL : _beantragt_content_find_demo_form_schema($entity_type_manager, $jurisdiction, $organisation);
  $messages[] = _beantragt_content_ensure_public_document(
    $entity_type_manager,
    $jurisdiction,
    $organisation,
    $form_schema instanceof EntityInterface ? $form_schema : NULL,
    'Merkblatt Antragstellung Musterstadt',
    '<p>Allgemeine Hinweise zur Antragstellung im Bürgerbüro.</p>',
    'Musterstadt Application Leaflet',
    '<p>General notes on applying at the citizen services office.</p>',
    'form_sidebar',
  );

  $messages[] = _beantragt_content_ensure_public_document(
    $entity_type_manager,
    $jurisdiction,
    $organisation,
    $form_schema instanceof EntityInterface ? $form_schema : NULL,
    'Nachreichungshinweise Musterstadt',
    '<p>So reichen Sie fehlende Unterlagen nach dem Absenden nach.</p>',
    'Musterstadt Follow-up Notes',
    '<p>How to send missing documents after you have submitted your application.</p>',
    'submission_success',
    20,
  );

  $messages[] = _beantragt_content_ensure_content_section(
    $entity_type_manager,
    $jurisdiction,
    $organisation,
    NULL,
    'Willkommen im Bürgerbüro',
    '<p>Hier finden Sie die Online-Anträge des Bürgerbüros Musterstadt. Wählen Sie ein Verfahren aus.</p>',
    'Welcome to the Citizen Office',
    '<p>Here you can find the online applications of the Musterstadt citizen office. Choose a procedure.</p>',
    'org_start',
    10,
  );

  $messages[] = _beantragt_content_ensure_content_section(
    $entity_type_manager,
    $jurisdiction,
    $organisation,
    $form_schema instanceof EntityInterface ? $form_schema : NULL,
    'Vor dem Ausfüllen',
    '<p>Bitte halten Sie Ihre Kontaktdaten und, falls vorhanden, passende Nachweise als PDF, JPG oder PNG bereit.</p>',
    'Before You Start',
    '<p>Please keep your contact details and, if available, supporting documents as PDF, JPG or PNG ready.</p>',
    'form_intro',
    10,
  );

  $messages[] = _beantragt_content_ensure_content_section(
    $entity_type_manager,
    $jurisdiction,
    $organisation,
    $form_schema instanceof EntityInterface ? $form_schema : NULL,
    'Fragen zum Antrag',
    '<p>Rückfragen zu Ihrem Antrag stellen Sie bitte über den Statusbereich.</p>',
    'Questions About Your Application',
    '<p>Please use the status area for questions about your application.</p>',
    'form_sidebar',
    20,
    ['Bearbeitungszeit und Kontakt', 'Processing Time and Contact'],
  );

  $messages[] = _beantragt_content_ensure_content_section(
    $entity_type_manager,
    $jurisdiction,
    $organisation,
    $form_schema instanceof EntityInterface ? $form_schema : NULL,
    'Nach der Einreichung',
    '<p>Sie erhalten ein Aktenzeichen. Bewahren Sie es auf, damit Sie den Status des Vorgangs wiederfinden.</p>',
    'After Submission',
    '<p>You receive a reference number. Keep it so you can find the case status again later.</p>',
    'submission_success',
    30,
  );

  $messages[] = _beantragt_content_ensure_boilerplate(
    $entity_type_manager,
    $jurisdiction,
    '000 Eingang bestätigen',
    'Ihr Anliegen ist eingegangen. Wir prüfen Zuständigkeit und Bearbeitungsweg und melden uns, falls Rückfragen entstehen.',
    '000 Confirm receipt',
    'Your request has been received. We will review responsibility and the next handling steps and contact you if we have questions.',
    ['000 Eingang bestaetigen'],
  );

  $messages[] = _beantragt_content_ensure_boilerplate(
    $entity_type_manager,
    $jurisdiction,
    '010 Zuständigkeit und Bearbeitungsweg geklärt',
    'Die zuständige Dienststelle und der weitere Bearbeitungsweg stehen fest. Der Vorgang geht jetzt in die passende Bearbeitung.',
    '010 Responsibility and handling route confirmed',
    'The responsible office and next handling steps are clear. The case now moves into the appropriate processing step.',
  );

  $messages[] = _beantragt_content_ensure_boilerplate(
    $entity_type_manager,
    $jurisdiction,
    '020 Rückfrage: Angaben ergänzen',
    'Zur weiteren Bearbeitung benötigen wir noch Angaben oder Unterlagen. Bitte ergänzen Sie die genannten Punkte über den Statusbereich.',
    '020 Follow-up information required',
    'We need additional information to continue. Please submit the requested details through the status area.',
    ['010 Rueckfrage erforderlich', '020 Nachforderung: fehlende Unterlagen'],
  );

  $messages[] = _beantragt_content_ensure_boilerplate(
    $entity_type_manager,
    $jurisdiction,
    '030 Rückfrage fachliche Prüfung',
    'Bei der fachlichen Prüfung ist eine Rückfrage entstanden. Bitte ergänzen Sie die unten genannten Informationen.',
    '030 Subject-matter question',
    'A question came up during subject-matter review. Please add the information listed below.',
  );

  $messages[] = _beantragt_content_ensure_boilerplate(
    $entity_type_manager,
    $jurisdiction,
    '040 Positive Rückmeldung mit Hinweisen',
    'Der Vorgang kann positiv abgeschlossen werden. Bitte beachten Sie die genannten Hinweise oder Auflagen.',
    '040 Positive response with notes',
    'The case can be closed positively. Please note the listed information or conditions.',
    ['040 Freigabe mit Auflagen'],
  );

  $messages[] = _beantragt_content_ensure_boilerplate(
    $entity_type_manager,
    $jurisdiction,
    '050 Negative Rückmeldung begründen',
    'Der Vorgang kann auf Grundlage der vorliegenden Angaben nicht positiv abgeschlossen werden. Die Begründung ist unten dokumentiert.',
    '050 Negative response rationale',
    'The case cannot be closed positively based on the submitted information. The rationale is documented below.',
    ['050 Ablehnung begründen'],
  );

  $messages[] = _beantragt_content_ensure_boilerplate(
    $entity_type_manager,
    $jurisdiction,
    '060 Anliegen zurückgezogen',
    'Das Anliegen wurde zurückgezogen. Der Vorgang wird ohne weitere Bearbeitung geschlossen.',
    '060 Request withdrawn',
    'The request has been withdrawn. The case will be closed without further processing.',
    ['060 Antrag zurückgezogen'],
  );

  return array_values(array_filter($messages));
}

/**
 * Finds one group by slug.
 */
function _beantragt_content_find_group_by_slug(string $bundle, string $slug): ?GroupInterface {
  $groups = \Drupal::entityTypeManager()->getStorage('group')->loadByProperties([
    'type' => $bundle,
    'field_slug' => $slug,
  ]);
  $group = reset($groups);

  return $group instanceof GroupInterface ? $group : NULL;
}

/**
 * Ensures one jurisdiction-scoped page exists.
 */
function _beantragt_content_ensure_page(
  EntityTypeManagerInterface $entity_type_manager,
  GroupInterface $jurisdiction,
  string $key,
  string $de_slug,
  string $de_title,
  string $de_body,
  string $en_slug,
  string $en_title,
  string $en_body,
  int $weight,
  bool $footer_visible = TRUE,
  bool $preserve_existing = FALSE,
): string {
  $node = _beantragt_content_find_node($entity_type_manager, 'page', $jurisdiction, 'field_page_key', $key, TRUE);
  if ($preserve_existing && $node instanceof NodeInterface) {
    return '';
  }
  if (!$node instanceof NodeInterface) {
    $node = $entity_type_manager->getStorage('node')->create([
      'type' => 'page',
      'langcode' => _beantragt_content_source_langcode(),
      'status' => 1,
    ]);
  }

  _beantragt_content_set_localized_body($node, $de_title, $de_body, $en_title, $en_body);
  _beantragt_content_set_localized_public_slug($node, $de_slug, $en_slug);
  if ($node->hasField('field_page_key')) {
    $node->set('field_page_key', $key);
  }
  if ($node->hasField('field_footer_visible')) {
    $node->set('field_footer_visible', (int) $footer_visible);
  }
  if ($node->hasField('field_page_weight')) {
    $node->set('field_page_weight', $weight);
  }
  if ($node->hasField('field_jurisdiction')) {
    $node->set('field_jurisdiction', ['target_id' => $jurisdiction->id()]);
  }
  return _beantragt_content_save_demo_node($node, 'page', $key);
}

/**
 * Ensures one public demo document exists.
 */
function _beantragt_content_ensure_public_document(
  EntityTypeManagerInterface $entity_type_manager,
  GroupInterface $jurisdiction,
  ?GroupInterface $organisation,
  ?EntityInterface $form_schema,
  string $de_title,
  string $de_body,
  string $en_title,
  string $en_body,
  string $placement = 'form_downloads',
  int $weight = 10,
): string {
  $file = _beantragt_content_ensure_demo_public_document_file($entity_type_manager);
  if (!$file instanceof FileInterface) {
    return 'Skipped public document because demo file could not be created.';
  }

  $titles = [$de_title, $en_title];
  $node = _beantragt_content_find_node_by_titles($entity_type_manager, 'public_document', $jurisdiction, $titles);
  if (!$node instanceof NodeInterface) {
    $node = $entity_type_manager->getStorage('node')->create([
      'type' => 'public_document',
      'langcode' => _beantragt_content_source_langcode(),
      'status' => 1,
    ]);
  }

  _beantragt_content_set_localized_body($node, $de_title, $de_body, $en_title, $en_body);
  if ($node->hasField('field_public_document_file')) {
    $node->set('field_public_document_file', ['target_id' => $file->id()]);
  }
  if ($node->hasField('field_jurisdiction')) {
    $node->set('field_jurisdiction', ['target_id' => $jurisdiction->id()]);
  }
  if ($node->hasField('field_organisation')) {
    $node->set('field_organisation', $organisation instanceof GroupInterface ? ['target_id' => $organisation->id()] : NULL);
  }
  if ($node->hasField('field_form_schema')) {
    $node->set('field_form_schema', $form_schema instanceof EntityInterface ? ['target_id' => $form_schema->id()] : NULL);
  }
  if ($node->hasField('field_content_placement')) {
    $node->set('field_content_placement', $placement);
  }
  if ($node->hasField('field_content_weight')) {
    $node->set('field_content_weight', $weight);
  }
  return _beantragt_content_save_demo_node($node, 'public document', $de_title);
}

