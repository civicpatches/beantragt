 */
function _beantragt_content_ensure_boilerplate_fields(EntityTypeManagerInterface $entity_type_manager): array {
  $messages = [];
  $field_config = $entity_type_manager->getStorage('field_config');

  if (!$field_config->load('node.boilerplate.body')) {
    $field_config->create([
      'field_name' => 'body',
      'entity_type' => 'node',
      'bundle' => 'boilerplate',
      'label' => 'Body',
      'required' => FALSE,
      'translatable' => TRUE,
      'settings' => [
        'display_summary' => TRUE,
        'required_summary' => FALSE,
        'allowed_formats' => ['basic_html'],
      ],
    ])->save();
    $messages[] = 'Added body to boilerplate.';
  }
  else {
    $messages = array_merge($messages, _beantragt_content_restrict_body_formats($entity_type_manager, 'boilerplate'));
  }

  if (!$field_config->load('node.boilerplate.field_boilerplate_type')) {
    $field_config->create([
      'field_name' => 'field_boilerplate_type',
      'entity_type' => 'node',
      'bundle' => 'boilerplate',
      'label' => 'Boilerplate type',
      'description' => 'Determines where this boilerplate appears.',
      'required' => TRUE,
      'translatable' => FALSE,
      'default_value' => [['value' => 'status_notes']],
    ])->save();
    $messages[] = 'Added field_boilerplate_type to boilerplate.';
  }

  if (!$field_config->load('node.boilerplate.field_jurisdiction')) {
    $field_config->create([
      'field_name' => 'field_jurisdiction',
      'entity_type' => 'node',
      'bundle' => 'boilerplate',
      'label' => 'Jurisdiction',
      'description' => 'The jurisdiction this boilerplate belongs to.',
      'required' => FALSE,
      'translatable' => FALSE,
      'settings' => [
        'handler' => 'default:group',
        'handler_settings' => [
          'target_bundles' => ['jur' => 'jur'],
          'sort' => ['field' => 'label', 'direction' => 'ASC'],
          'auto_create' => FALSE,
        ],
      ],
    ])->save();
    $messages[] = 'Added field_jurisdiction to boilerplate.';
  }

  if (!$field_config->load('node.boilerplate.field_organisation')) {
    $field_config->create([
      'field_name' => 'field_organisation',
      'entity_type' => 'node',
      'bundle' => 'boilerplate',
      'label' => 'Organisation',
      'description' => 'Limit this boilerplate to one organisation. Leave empty for all organisations in the jurisdiction.',
      'required' => FALSE,
      'translatable' => FALSE,
      'settings' => [
        'handler' => 'default:group',
        'handler_settings' => [
          'target_bundles' => ['org' => 'org'],
          'sort' => ['field' => 'label', 'direction' => 'ASC'],
          'auto_create' => FALSE,
          'auto_create_bundle' => '',
        ],
      ],
    ])->save();
    $messages[] = 'Added field_organisation to boilerplate.';
  }

  return $messages;
}

/**
 * Ensures public document bundle fields exist.
 *
 * @return string[]
 *   Human-readable changes.
 */
function _beantragt_content_ensure_public_document_fields(EntityTypeManagerInterface $entity_type_manager): array {
  $messages = [];
  $field_config = $entity_type_manager->getStorage('field_config');

  if (!$field_config->load('node.public_document.body')) {
    $field_config->create([
      'field_name' => 'body',
      'entity_type' => 'node',
      'bundle' => 'public_document',
      'label' => 'Description',
      'description' => 'Short public description shown next to the download.',
      'required' => FALSE,
      'translatable' => TRUE,
      'settings' => [
        'display_summary' => TRUE,
        'required_summary' => FALSE,
        'allowed_formats' => ['basic_html'],
      ],
    ])->save();
    $messages[] = 'Added body to public_document.';
  }
  else {
    $messages = array_merge($messages, _beantragt_content_restrict_body_formats($entity_type_manager, 'public_document'));
  }

  $public_document_file_config = $field_config->load('node.public_document.field_public_document_file');
  if (!$public_document_file_config) {
    $field_config->create([
      'field_name' => 'field_public_document_file',
      'entity_type' => 'node',
      'bundle' => 'public_document',
      'label' => 'Public file',
      'description' => 'Editorial public file. Do not use for citizen submission attachments.',
      'required' => TRUE,
      'translatable' => FALSE,
      'settings' => [
        'file_directory' => 'public_documents',
        'file_extensions' => 'pdf jpg jpeg png',
        'max_filesize' => '20 MB',
        'uri_scheme' => 'private',
        'description_field' => FALSE,
        'handler' => 'default:file',
        'handler_settings' => [],
      ],
    ])->save();
    $messages[] = 'Added field_public_document_file to public_document.';
  }
  elseif ($public_document_file_config->getSetting('uri_scheme') !== 'private') {
    $public_document_file_config->setSetting('uri_scheme', 'private');
    $public_document_file_config->save();
    $messages[] = 'Changed public document file storage to private.';
  }

  if (!$field_config->load('node.public_document.field_jurisdiction')) {
    $field_config->create([
      'field_name' => 'field_jurisdiction',
      'entity_type' => 'node',
      'bundle' => 'public_document',
      'label' => 'Jurisdiction',
      'description' => 'The jurisdiction this public document belongs to.',
      'required' => FALSE,
      'translatable' => FALSE,
      'settings' => [
        'handler' => 'default:group',
        'handler_settings' => [
          'target_bundles' => ['jur' => 'jur'],
          'sort' => ['field' => 'label', 'direction' => 'ASC'],
          'auto_create' => FALSE,
        ],
      ],
    ])->save();
    $messages[] = 'Added field_jurisdiction to public_document.';
  }

  if (!$field_config->load('node.public_document.field_organisation')) {
    $field_config->create([
      'field_name' => 'field_organisation',
      'entity_type' => 'node',
      'bundle' => 'public_document',
      'label' => 'Organisation',
      'description' => 'Limit this public document to one organisation. Leave empty for all organisations in the jurisdiction.',
      'required' => FALSE,
      'translatable' => FALSE,
      'settings' => [
        'handler' => 'default:group',
        'handler_settings' => [
          'target_bundles' => ['org' => 'org'],
          'sort' => ['field' => 'label', 'direction' => 'ASC'],
          'auto_create' => FALSE,
          'auto_create_bundle' => '',
        ],
      ],
    ])->save();
    $messages[] = 'Added field_organisation to public_document.';
  }

  if (!$field_config->load('node.public_document.field_form_schema')) {
    $field_config->create([
      'field_name' => 'field_form_schema',
      'entity_type' => 'node',
      'bundle' => 'public_document',
      'label' => 'Form schema',
      'description' => 'Optional form this document belongs to. Leave empty for workspace-wide documents.',
      'required' => FALSE,
      'translatable' => FALSE,
      'settings' => [
        'handler' => 'default:form_schema',
        'handler_settings' => [
          'auto_create' => FALSE,
        ],
      ],
    ])->save();
    $messages[] = 'Added field_form_schema to public_document.';
  }

  if (!$field_config->load('node.public_document.field_content_placement')) {
    $field_config->create([
      'field_name' => 'field_content_placement',
      'entity_type' => 'node',
      'bundle' => 'public_document',
      'label' => 'Placement',
      'description' => 'Where this public document may be shown.',
      'required' => TRUE,
      'translatable' => FALSE,
      'default_value' => [['value' => 'form_downloads']],
    ])->save();
    $messages[] = 'Added field_content_placement to public_document.';
  }

  if (!$field_config->load('node.public_document.field_content_weight')) {
    $field_config->create([
      'field_name' => 'field_content_weight',
      'entity_type' => 'node',
      'bundle' => 'public_document',
      'label' => 'Sort weight',
      'description' => 'Lower numbers appear earlier in public document lists.',
      'required' => FALSE,
      'translatable' => FALSE,
      'default_value' => [['value' => 0]],
    ])->save();
    $messages[] = 'Added field_content_weight to public_document.';
  }

  return $messages;
}

