    'org_start' => 'Organisation start',
    'form_intro' => 'Form intro',
    'form_downloads' => 'Form downloads',
    'form_sidebar' => 'Form sidebar',
    'submission_success' => 'Submission success',
  ];
}

/**
 * Ensures an existing list_string field storage accepts the given values.
 *
 * @param array<string, string> $allowed_values
 *   Canonical values to add or refresh.
 *
 * @return string[]
 *   Human-readable changes.
 */
function _beantragt_content_ensure_allowed_values(
  EntityTypeManagerInterface $entity_type_manager,
  string $field_storage_id,
  array $allowed_values,
): array {
  $storage = $entity_type_manager->getStorage('field_storage_config')->load($field_storage_id);
  if (!$storage) {
    return [];
  }

  $settings = $storage->get('settings') ?? [];
  $current = is_array($settings['allowed_values'] ?? NULL)
    ? $settings['allowed_values']
    : [];
  $merged = $allowed_values + array_diff_key($current, $allowed_values);
  if ($current === $merged) {
    return [];
  }

  $settings['allowed_values'] = $merged;
  $storage->set('settings', $settings);
  $storage->save();

  return [sprintf('Updated %s allowed values.', $field_storage_id)];
}

/**
 * Ensures page bundle fields exist.
 *
 * @return string[]
 *   Human-readable changes.
 */
function _beantragt_content_ensure_page_fields(EntityTypeManagerInterface $entity_type_manager): array {
  $messages = [];
  $field_config = $entity_type_manager->getStorage('field_config');

  if (!$field_config->load('node.page.body')) {
    $field_config->create([
      'field_name' => 'body',
      'entity_type' => 'node',
      'bundle' => 'page',
      'label' => 'Body',
      'required' => FALSE,
      'translatable' => TRUE,
      'settings' => [
        'display_summary' => TRUE,
        'required_summary' => FALSE,
        'allowed_formats' => ['basic_html'],
      ],
    ])->save();
    $messages[] = 'Added body to page.';
  }
  else {
    $messages = array_merge($messages, _beantragt_content_restrict_body_formats($entity_type_manager, 'page'));
  }

  if (!$field_config->load('node.page.field_page_key')) {
    $field_config->create([
      'field_name' => 'field_page_key',
      'entity_type' => 'node',
      'bundle' => 'page',
      'label' => 'Page key',
      'description' => 'Stable machine key used by the public API, for example privacy or legal_notice.',
      'required' => TRUE,
      'translatable' => FALSE,
    ])->save();
    $messages[] = 'Added field_page_key to page.';
  }

  if (!$field_config->load('node.page.field_public_slug')) {
    $field_config->create([
      'field_name' => 'field_public_slug',
      'entity_type' => 'node',
      'bundle' => 'page',
      'label' => 'Public slug',
      'description' => 'Public route segment chosen by the jurisdiction, for example datenschutz, kontakt or privacy.',
      'required' => FALSE,
      'translatable' => TRUE,
    ])->save();
    $messages[] = 'Added field_public_slug to page.';
  }

  if (!$field_config->load('node.page.field_footer_visible')) {
    $field_config->create([
      'field_name' => 'field_footer_visible',
      'entity_type' => 'node',
      'bundle' => 'page',
      'label' => 'Show in public footer',
      'description' => 'When enabled, the public page list can be used for footer navigation.',
      'required' => FALSE,
      'translatable' => FALSE,
      'default_value' => [['value' => 1]],
    ])->save();
    $messages[] = 'Added field_footer_visible to page.';
  }

  if (!$field_config->load('node.page.field_page_weight')) {
    $field_config->create([
      'field_name' => 'field_page_weight',
      'entity_type' => 'node',
      'bundle' => 'page',
      'label' => 'Navigation weight',
      'description' => 'Lower numbers appear earlier in public page lists.',
      'required' => FALSE,
      'translatable' => FALSE,
      'default_value' => [['value' => 0]],
    ])->save();
    $messages[] = 'Added field_page_weight to page.';
  }

  if (!$field_config->load('node.page.field_jurisdiction')) {
    $field_config->create([
      'field_name' => 'field_jurisdiction',
      'entity_type' => 'node',
      'bundle' => 'page',
      'label' => 'Jurisdiction',
      'description' => 'The jurisdiction this page belongs to.',
      'required' => FALSE,
      'translatable' => FALSE,
      'settings' => [
        'handler' => 'default:group',
        'handler_settings' => [
          'target_bundles' => ['jur' => 'jur'],
          'sort' => ['field' => 'label', 'direction' => 'ASC'],
          'auto_create' => FALSE,
        ],
      ],
    ])->save();
    $messages[] = 'Added field_jurisdiction to page.';
  }

  if (!$field_config->load('node.page.field_organisation')) {
    $field_config->create([
      'field_name' => 'field_organisation',
      'entity_type' => 'node',
      'bundle' => 'page',
      'label' => 'Organisation',
      'description' => 'Limit this page to one organisation. Leave empty for all organisations in the jurisdiction.',
      'required' => FALSE,
      'translatable' => FALSE,
      'settings' => [
        'handler' => 'default:group',
        'handler_settings' => [
          'target_bundles' => ['org' => 'org'],
          'sort' => ['field' => 'label', 'direction' => 'ASC'],
          'auto_create' => FALSE,
          'auto_create_bundle' => '',
        ],
      ],
    ])->save();
    $messages[] = 'Added field_organisation to page.';
  }

  return $messages;
}

/**
 * Ensures boilerplate bundle fields exist.
 *
 * @return string[]
