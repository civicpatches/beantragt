{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "form_schema.schema.json",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "id": {
      "type": "string",
      "title": "Schema ID",
      "description": "Stable identifier of this form schema (e.g. demo_baumschutz_negativerklaerung)",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "title": {
      "type": "string",
      "title": "Title",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "i18n": {
      "type": "object",
      "$ref": "#/definitions/schemaTranslations",
      "title": "Localized schema text"
    },
    "version": {
      "type": "integer",
      "title": "Version",
      "default": 1,
      "minimum": 1
    },
    "sections": {
      "type": "array",
      "title": "Sections",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "title", "fields"],
        "properties": {
          "id": {
            "type": "string",
            "title": "Section ID",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "title": {
            "type": "string",
            "title": "Section Title"
          },
          "description": {
            "type": "string",
            "title": "Section Description"
          },
          "i18n": {
            "type": "object",
            "$ref": "#/definitions/sectionTranslations",
            "title": "Localized section text"
          },
          "fields": {
            "type": "array",
            "title": "Fields",
            "items": {
              "type": "object",
              "additionalProperties": true,
              "required": ["id", "type", "label"],
              "properties": {
                "id": {
                  "type": "string",
                  "title": "Field ID",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "type": {
                  "type": "string",
                  "title": "Type",
                  "enum": [
                    "text",
                    "email",
                    "date",
                    "tel",
                    "checkbox",
                    "textarea",
                    "number",
                    "select",
                    "radio",
                    "address",
                    "file"
                  ]
                },
                "label": {
                  "type": "string",
                  "title": "Label"
                },
                "placeholder": {
                  "type": "string",
                  "title": "Placeholder"
                },
                "i18n": {
                  "type": "object",
                  "$ref": "#/definitions/fieldTranslations",
                  "title": "Localized field text"
                },
                "crm_key": {
                  "type": "string",
                  "title": "CRM Key",
                  "description": "Dotted key for CRM extraction (e.g. person.email)"
                },
                "semantics": {
                  "type": "object",
                  "title": "Field semantics",
                  "description": "Stable integration metadata independent of labels and UI widgets.",
                  "additionalProperties": false,
                  "properties": {
                    "concept": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
                    },
                    "sourcePath": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1000
                    }
                  }
                },
                "format": {
                  "type": "string",
                  "title": "Format",
                  "description": "Optional format hint (e.g. postal_code)",
                  "enum": [
                    "postal_code",
                    "iban",
                    "bic",
                    "tax_id",
                    "currency",
                    "reference_number",
                    "url"
                  ]
                },
                "validation": {
                  "type": "object",
                  "title": "Validation",
                  "additionalProperties": true,
                  "properties": {
                    "pattern": {
                      "type": "string",
                      "title": "Pattern",
                      "maxLength": 160
                    },
                    "minLength": { "type": "integer", "title": "Min Length" },
                    "maxLength": { "type": "integer", "title": "Max Length" }
                  }
                },
                "analysis": {
                  "type": "object",
                  "title": "Attachment analysis",
                  "description": "Optional analysis profile for file fields. It describes the intended document pre-check. It does not by itself allow external AI egress.",
                  "additionalProperties": true,
                  "required": ["egressPolicy"],
                  "properties": {
                    "enabled": {
                      "type": "boolean",
                      "title": "Enabled",
                      "default": false
                    },
                    "version": {
                      "type": "integer",
                      "title": "Profile version",
                      "minimum": 1,
                      "default": 1
                    },
                    "expectedDocumentType": {
                      "type": "string",
                      "title": "Expected document type",
                      "maxLength": 5000
                    },
                    "promptSuggestion": {
                      "type": "string",
                      "title": "Prompt suggestion",
                      "description": "Legacy single check instruction. Ignored at runtime once citizenPrompt or staffPrompt is set.",
                      "maxLength": 5000
                    },
                    "citizenPrompt": {
                      "type": "string",
                      "title": "Upload check instruction",
                      "description": "Story A: checked right after the upload. The applicant only sees yes/no hints, never values from the document.",
                      "maxLength": 5000
                    },
                    "staffPrompt": {
                      "type": "string",
                      "title": "Staff evaluation instruction",
                      "description": "Story B: purpose-bound values read for staff after submission, only through a sovereign or local service.",
                      "maxLength": 5000
                    },
                    "redaction": {
                      "type": "string",
                      "title": "Redaction before the AI check",
                      "description": "Applies under sovereign_only and local_only only. A missing value means none.",
                      "enum": ["none", "when_possible"]
                    },
                    "resultSchema": {
                      "type": "object",
                      "title": "Result subschema",
                      "additionalProperties": true,
                      "maxProperties": 50
                    },
                    "modelClass": {
                      "type": "string",
                      "title": "Model class",
                      "enum": [
                        "local_ocr",
                        "local_vision",
                        "ollama",
                        "openai_compatible",
                        "openai",
                        "claude_sonnet"
                      ]
                    },
                    "egressPolicy": {
                      "type": "string",
                      "title": "AI egress policy",
                      "enum": [
                        "no_ai",
                        "local_only",
                        "sovereign_only",
                        "external_redacted",
                        "external_allowed"
                      ],
                      "default": "no_ai"
                    }
                  },
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "egressPolicy": { "const": "no_ai" }
                        },
                        "required": ["egressPolicy"]
                      },
                      "then": {
                        "not": {
                          "required": ["modelClass"]
                        }
                      }
                    }
                  ]
                },
                "options": {
                  "type": "array",
                  "title": "Options",
                  "description": "For select/radio: option labels (used both as display and stored value).",
                  "items": {
                    "type": "string"
                  }
                },
                "computed": {
                  "type": "object",
                  "title": "Computed field specification",
                  "description": "When present, this field's value is derived server-side by a registered ComputeFunction plugin. The client-submitted value is always overwritten. The `fn` pattern matches plugin ids; the authoritative catalog check happens server-side at evaluate-time.",
                  "additionalProperties": false,
                  "required": ["fn", "args"],
                  "properties": {
                    "fn": {
                      "type": "string",
                      "title": "Function id",
                      "description": "Machine id of the ComputeFunction plugin to invoke (e.g. 'approvalTier').",
                      "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$"
                    },
                    "args": {
                      "type": "array",
                      "title": "Arguments",
                      "description": "Ordered list of field ids whose submitted values are passed as arguments to the function.",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                },
                "widget": {
                  "type": "object",
                  "title": "Address widget",
                  "description": "Optional address input behavior. Boundary checks are advisory and never block submission.",
                  "additionalProperties": false,
                  "minProperties": 1,
                  "properties": {
                    "autocomplete": {
                      "type": "boolean",
                      "default": true
                    },
                    "map": {
                      "type": "boolean",
                      "default": false
                    },
                    "boundary": {
                      "type": "string",
                      "enum": ["off", "advisory"],
                      "default": "off"
                    }
                  }
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "type": { "const": "file" }
                    },
                    "required": ["type"]
                  },
                  "else": {
                    "not": {
                      "required": ["analysis"]
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "type": { "const": "address" }
                    },
                    "required": ["type"]
                  },
                  "else": {
                    "not": {
                      "required": ["widget"]
                    }
                  }
                }
              ]
            }
          },
          "addressGroups": {
            "type": "array",
            "title": "Address presentation groups",
            "description": "UI-only address helpers. Referenced fields remain the canonical persisted values.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "fields"],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "fields": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["street", "houseNumber", "postcode", "city"],
                  "properties": {
                    "street": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
                    "houseNumber": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
                    "postcode": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
                    "city": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
                  }
                },
                "autocomplete": {
                  "type": "boolean",
                  "default": true
                },
                "map": {
                  "type": "boolean",
                  "default": false
                },
                "boundary": {
                  "type": "string",
                  "enum": ["off", "advisory"],
                  "default": "off"
                }
              }
            }
          }
        }
      }
    },
    "contextSources": {
      "type": "array",
      "title": "Assistant context sources",
      "maxItems": 24,
      "items": {
        "$ref": "#/definitions/contextSource"
      }
    },
    "precheckSchema": {
      "$ref": "#/definitions/precheckSchema"
    },
    "semantics": {
      "type": "object",
      "title": "Semantics",
      "additionalProperties": true,
      "properties": {
        "category": { "type": "string", "title": "Category" },
        "process": { "type": "string", "title": "Process Key" },
        "entities": {
          "type": "array",
          "title": "Entities",
          "items": { "type": "string" }
        }
      }
    },
    "source": {
      "type": "object",
      "title": "Source",
      "additionalProperties": true,
      "properties": {
        "type": { "type": "string", "title": "Source Type" },
        "file": { "type": "string", "title": "File" },
        "url": { "type": "string", "title": "URL" },
        "label": { "type": "string", "title": "Label" }
      }
    },
    "delivery": {
      "type": "object",
      "title": "Delivery Policy",
      "description": "Controls whether submitted applications stay self-contained in beantragt.ai or are queued for pass-through delivery.",
      "additionalProperties": false,
      "properties": {
        "processingMode": {
          "type": "string",
          "title": "Processing mode",
          "enum": ["self_contained", "pass_through"],
          "default": "self_contained"
        },
        "adapter": {
          "type": "string",
          "title": "Delivery adapter",
          "enum": ["mock", "webhook", "fit_connect"]
        }
      }
    }
  },
  "definitions": {
    "contextSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "title"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["public_document", "form_attachment"]
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "placement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "changed": {
          "type": "integer",
          "minimum": 0
        },
        "enabledFor": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["editor", "citizen_assistant"]
          }
        },
        "requiredCitation": {
          "type": "boolean"
        }
      }
    },
    "precheckSchema": {
      "type": "object",
      "title": "Reviewed citizen precheck",
      "description": "Versioned factual criteria with exact local evidence. Citizen answers are runtime facts and are not stored in this schema.",
      "additionalProperties": false,
      "required": ["version", "criteria"],
      "properties": {
        "version": {
          "const": 1
        },
        "criteria": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/definitions/precheckCriterion"
          }
        }
      }
    },
    "precheckCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "factKey", "factType", "label", "question", "affects", "order", "reviewStatus", "evidence"],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 100,
          "pattern": "^[a-z][a-z0-9_]{0,99}$"
        },
        "factKey": {
          "type": "string",
          "maxLength": 100,
          "pattern": "^[a-z][a-z0-9_]{0,99}$"
        },
        "fieldId": {
          "type": "string",
          "maxLength": 100,
          "pattern": "^[a-z][a-z0-9_]{0,99}$",
          "description": "Canonical non-personal form field represented by this criterion. Required before approval."
        },
        "factType": {
          "type": "string",
          "enum": ["boolean", "number", "text", "enum"]
        },
        "label": {
          "$ref": "#/definitions/precheckLocalizedText"
        },
        "question": {
          "$ref": "#/definitions/precheckLocalizedText"
        },
        "affects": {
          "type": "string",
          "enum": ["procedure_fit", "obligation", "both"]
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "reviewStatus": {
          "type": "string",
          "enum": ["suggested", "approved", "rejected"]
        },
        "evidence": {
          "$ref": "#/definitions/precheckEvidence"
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "factType": {
                "const": "enum"
              }
            },
            "required": ["factType"]
          },
          "then": {
            "required": ["options"]
          },
          "else": {
            "not": {
              "required": ["options"]
            }
          }
        }
      ]
    },
    "precheckLocalizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["de"],
      "properties": {
        "de": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "precheckEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceType", "quote"],
      "properties": {
        "sourceType": {
          "type": "string",
          "enum": ["form_source", "context_source"]
        },
        "sourceId": {
          "type": "string",
          "format": "uuid"
        },
        "sourceTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "page": {
          "type": "integer",
          "minimum": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "sourceType": {
                "const": "context_source"
              }
            },
            "required": ["sourceType"]
          },
          "then": {
            "required": ["sourceId"]
          },
          "else": {
            "not": {
              "required": ["sourceId"]
            }
          }
        }
      ]
    },
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "label": { "type": "string" },
        "placeholder": { "type": "string" }
      }
    },
    "localizedFieldText": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string" },
        "placeholder": { "type": "string" },
        "options": {
          "description": "Localized option labels. Arrays map by option index, objects map canonical option values to localized display labels.",
          "oneOf": [
            {
              "type": "array",
              "items": { "type": "string" }
            },
            {
              "type": "object",
              "additionalProperties": { "type": "string" }
            }
          ]
        }
      }
    },
    "schemaTranslations": {
      "type": "object",
      "description": "Map of BCP-47-like locale keys, for example en or de-DE.",
      "additionalProperties": {
        "$ref": "#/definitions/localizedText"
      }
    },
    "sectionTranslations": {
      "type": "object",
      "description": "Map of BCP-47-like locale keys, for example en or de-DE.",
      "additionalProperties": {
        "$ref": "#/definitions/localizedText"
      }
    },
    "fieldTranslations": {
      "type": "object",
      "description": "Map of BCP-47-like locale keys, for example en or de-DE.",
      "additionalProperties": {
        "$ref": "#/definitions/localizedFieldText"
      }
    }
  }
}
