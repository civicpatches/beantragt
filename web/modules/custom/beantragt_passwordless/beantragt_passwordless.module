<?php

/**
 * @file
 * Module file for beantragt_passwordless.
 */

declare(strict_types=1);

use Drupal\language\ConfigurableLanguageManagerInterface;
use Drupal\user\UserInterface;

/**
 * Implements hook_user_presave().
 */
function beantragt_passwordless_user_presave(UserInterface $account): void {
  $original = $account->getOriginal();
  if (!$account->isNew() && $original instanceof UserInterface
    && strtolower(trim((string) $original->getEmail())) !== strtolower(trim((string) $account->getEmail()))) {
    \Drupal::service('beantragt_passwordless.verified_mail')->invalidate($account);
  }
}

/**
 * Implements hook_user_delete().
 */
function beantragt_passwordless_user_delete(UserInterface $account): void {
  \Drupal::service('beantragt_passwordless.verified_mail')->invalidate($account);
}

/**
 * Implements hook_mail().
 */
function beantragt_passwordless_mail(string $key, array &$message, array $params): void {
  switch ($key) {
    case 'verification_code':
      $langcode = $message['langcode'] ?? 'en';
      $mail_config = NULL;

      // Load mail config in the message's language if Language module is
      // available (provides getLanguageConfigOverride on the manager).
      $language_manager = \Drupal::languageManager();
      if ($language_manager instanceof ConfigurableLanguageManagerInterface) {
        $override = $language_manager->getLanguageConfigOverride($langcode, 'beantragt_passwordless.mail');
        $mail_config = $override->get($key);
      }

      // Fallback to default config if no translation found.
      if (empty($mail_config)) {
        $mail_config = \Drupal::config('beantragt_passwordless.mail')->get($key);
      }

      // Token replacements.
      $replacements = [
        '@code' => $params['code'] ?? '',
        '@expires_in' => $params['expires_in'] ?? '10',
        '@platform_name' => $params['platform_name'] ?? 'beantragt.ai',
      ];

      $message['subject'] = strtr($mail_config['subject'], $replacements);
      $message['body'][] = strtr($mail_config['body'], $replacements);
      break;
  }
}

/**
 * Implements hook_cron().
 *
 * Cleans up expired OTP codes older than 1 hour.
 */
function beantragt_passwordless_cron(): void {
  /** @var \Drupal\beantragt_passwordless\Service\OtpService $otp_service */
  $otp_service = \Drupal::service('beantragt_passwordless.otp');
  $otp_service->cleanupExpiredCodes();
}
