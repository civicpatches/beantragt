<?php

/**
 * @file
 * Install, update and uninstall functions for beantragt_passwordless.
 */

declare(strict_types=1);

/**
 * Implements hook_schema().
 */
function beantragt_passwordless_schema(): array {
  $schema['beantragt_passwordless_codes'] = [
    'description' => 'Stores OTP codes for passwordless authentication.',
    'fields' => [
      'id' => [
        'description' => 'Primary Key: Unique code ID.',
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'email' => [
        'description' => 'Email address.',
        'type' => 'varchar',
        'length' => 254,
        'not null' => TRUE,
      ],
      'code' => [
        'description' => 'Bcrypt hash of the OTP code.',
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
      ],
      'attempts' => [
        'description' => 'Number of verification attempts.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
      'created' => [
        'description' => 'Unix timestamp when code was created.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'expires' => [
        'description' => 'Unix timestamp when code expires.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'verified' => [
        'description' => 'Whether the code has been verified (0=pending, 1=verified, 2=invalidated).',
        'type' => 'int',
        'size' => 'tiny',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'email' => ['email'],
      'expires' => ['expires'],
      'email_verified' => ['email', 'verified'],
      'verified' => ['verified'],
    ],
  ];

  $schema['beantragt_verified_account_mail'] = [
    'description' => 'Mailbox verification provenance bound to a user and current address.',
    'fields' => [
      'uid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'mail' => ['type' => 'varchar', 'length' => 254, 'not null' => TRUE],
      'source' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'verified' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
    ],
    'primary key' => ['uid'],
    'indexes' => ['mail' => ['mail']],
  ];

  return $schema;
}

/**
 * Widen OTP code column for bcrypt hashes and update indexes.
 *
 * Changes OTP storage from plaintext to bcrypt hashes.
 * The column needs to be widened from varchar(6) to varchar(255).
 * The email_code index is replaced with email_verified since we
 * can no longer filter by hashed code value.
 */
function beantragt_passwordless_update_10001(): string {
  $schema = \Drupal::database()->schema();

  // Widen the code column to hold bcrypt hashes (60 chars, but 255 for safety).
  $schema->changeField('beantragt_passwordless_codes', 'code', 'code', [
    'description' => 'Bcrypt hash of the OTP code.',
    'type' => 'varchar',
    'length' => 255,
    'not null' => TRUE,
  ]);

  // Drop the old email_code index (no longer useful with hashed codes).
  if ($schema->indexExists('beantragt_passwordless_codes', 'email_code')) {
    $schema->dropIndex('beantragt_passwordless_codes', 'email_code');
  }

  // Add new email_verified index for the lookup pattern used in verification.
  if (!$schema->indexExists('beantragt_passwordless_codes', 'email_verified')) {
    $schema->addIndex('beantragt_passwordless_codes', 'email_verified', ['email', 'verified'], [
      'fields' => [
        'email' => [
          'type' => 'varchar',
          'length' => 254,
        ],
        'verified' => [
          'type' => 'int',
          'size' => 'tiny',
        ],
      ],
    ]);
  }

  // Invalidate all existing plaintext codes since they cannot be verified
  // against the new hashed verification logic.
  \Drupal::database()->update('beantragt_passwordless_codes')
    ->fields(['verified' => 2])
    ->condition('verified', 0)
    ->execute();

  return 'Widened OTP code column for bcrypt hashes and invalidated existing plaintext codes.';
}

/**
 * Enables verified citizen self-registration for passwordless login.
 */
function beantragt_passwordless_update_10002(): string {
  $config = \Drupal::configFactory()->getEditable('beantragt_passwordless.settings');
  if ($config->get('auto_register') === TRUE) {
    return 'Passwordless auto-registration was already enabled.';
  }

  $config->set('auto_register', TRUE)->save();
  return 'Enabled passwordless auto-registration for verified citizen emails.';
}

/**
 * Adds mailbox provenance without inferring existing account addresses.
 */
function beantragt_passwordless_update_10003(): string {
  $schema = \Drupal::database()->schema();
  if (!$schema->tableExists('beantragt_verified_account_mail')) {
    $schema->createTable('beantragt_verified_account_mail', [
      'fields' => [
        'uid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
        'mail' => ['type' => 'varchar', 'length' => 254, 'not null' => TRUE],
        'source' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
        'verified' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      ],
      'primary key' => ['uid'],
      'indexes' => ['mail' => ['mail']],
    ]);
  }
  return 'Added verified account mailbox provenance without inferring existing addresses.';
}
